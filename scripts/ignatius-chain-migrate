#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: ignatius-chain-migrate [--plan] [DATABASE_URL]' >&2
}

mode=apply
if [[ "${1:-}" == "--plan" ]]; then
  mode=plan
  shift
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd "$script_dir/.." && pwd)"
migration_dir="$repo_dir/db/migrations"
schema_version=1
protocol_version=0.0.0-alpha

digest_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  else
    shasum -a 256 "$1" | cut -d ' ' -f 1
  fi
}

migrations=()
while IFS= read -r file; do
  migrations+=("$file")
done < <(find "$migration_dir" -maxdepth 1 -type f \
  -name '[0-9][0-9][0-9][0-9]-*.sql' | LC_ALL=C sort)

if [[ ${#migrations[@]} -eq 0 ]]; then
  echo 'No Ignatius chain migrations found.' >&2
  exit 1
fi

expected=1
for file in "${migrations[@]}"; do
  name="$(basename "$file")"
  if [[ ! "$name" =~ ^[0-9]{4}-[a-z0-9-]+\.sql$ ]]; then
    echo "Invalid migration name: $name." >&2
    exit 1
  fi
  version_text="${name%%-*}"
  version=$((10#$version_text))
  if [[ "$version" -ne "$expected" ]]; then
    echo "Migration sequence gap: expected $expected, found $version ($name)." >&2
    exit 1
  fi
  digest="$(digest_file "$file")"
  printf '%04d %s %s\n' "$version" "$digest" "$name"
  expected=$((expected + 1))
done

if [[ "$mode" == plan ]]; then
  exit 0
fi

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

database_url="$1"
command -v psql >/dev/null 2>&1 || {
  echo 'psql is required to apply Ignatius chain migrations.' >&2
  exit 1
}

registry_present="$(psql "$database_url" -XAtq -v ON_ERROR_STOP=1 \
  -c "SELECT to_regclass('\"gw_ledger\".\"ChainMigration\"') IS NOT NULL;")"

if [[ "$registry_present" == t ]]; then
  installed_state="$(psql "$database_url" -XAtq -F ' ' -v ON_ERROR_STOP=1 \
    -c 'SELECT COALESCE(max("version"), 0), COALESCE(max("schema_version"), 0), COALESCE((SELECT "protocol_version" FROM "gw_ledger"."ChainMigration" ORDER BY "version" DESC LIMIT 1), '\''\'') FROM "gw_ledger"."ChainMigration";')"
  read -r installed_version installed_schema installed_protocol <<< "$installed_state"
  available_version="${#migrations[@]}"
  if [[ "$installed_version" -gt "$available_version" ]]; then
    echo "Installed migration version $installed_version is newer than available version $available_version." >&2
    exit 1
  fi
  if [[ "$installed_schema" -gt "$schema_version" ]]; then
    echo "Installed schema version $installed_schema is newer than supported version $schema_version." >&2
    exit 1
  fi
  if [[ -n "$installed_protocol" && "$installed_protocol" != "$protocol_version" ]]; then
    echo "Installed protocol version $installed_protocol is incompatible with supported version $protocol_version." >&2
    exit 1
  fi
fi

for file in "${migrations[@]}"; do
  name="$(basename "$file")"
  version_text="${name%%-*}"
  version=$((10#$version_text))
  digest="$(digest_file "$file")"

  if [[ "$registry_present" == t ]]; then
    installed="$(psql "$database_url" -XAtq -v ON_ERROR_STOP=1 \
      -c 'SELECT encode("digest", '\''hex'\'') FROM "gw_ledger"."ChainMigration" WHERE "version" = '"$version"';')"
    if [[ -n "$installed" ]]; then
      if [[ "$installed" != "$digest" ]]; then
        echo "Migration digest mismatch for $name." >&2
        exit 1
      fi
      continue
    fi
  fi

  PGOPTIONS="-c ignatius.migration.version=$version -c ignatius.migration.name=$name -c ignatius.migration.digest=$digest -c ignatius.migration.schema_version=$schema_version -c ignatius.migration.protocol_version=$protocol_version" \
  psql "$database_url" -X -v ON_ERROR_STOP=1 --single-transaction \
    -c "SELECT pg_advisory_xact_lock(hashtextextended('ignatius:chain-migration', 0));" \
    -f "$file" \
    -c 'INSERT INTO "gw_ledger"."ChainMigration" ("version", "name", "digest", "schema_version", "protocol_version") VALUES (current_setting('\''ignatius.migration.version'\'')::BIGINT, current_setting('\''ignatius.migration.name'\''), decode(current_setting('\''ignatius.migration.digest'\''), '\''hex'\''), current_setting('\''ignatius.migration.schema_version'\'')::BIGINT, current_setting('\''ignatius.migration.protocol_version'\'')) ON CONFLICT ("version") DO NOTHING;' \
    -c 'DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM "gw_ledger"."ChainMigration" WHERE "version" = current_setting('\''ignatius.migration.version'\'')::BIGINT AND "name" = current_setting('\''ignatius.migration.name'\'') AND "digest" = decode(current_setting('\''ignatius.migration.digest'\''), '\''hex'\'')) THEN RAISE EXCEPTION '\''Ignatius migration identity mismatch for version %'\'', current_setting('\''ignatius.migration.version'\''); END IF; END $$;'
  registry_present=t
done
