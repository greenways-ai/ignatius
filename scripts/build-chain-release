#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import re
import sys
import zipfile
from pathlib import Path

RELEASE_FILES = (
    "db/chain-release.edn",
    "db/README.md",
    "db/sql/full.sql",
    "db/contracts/ledger-client/generated.ts",
)


def release_version(descriptor: str) -> str:
    match = re.search(r':ignatius\.chain/release-version\s+"([^"]+)"', descriptor)
    if match is None:
        raise SystemExit("db/chain-release.edn has no release version")
    return match.group(1)


def descriptor_integer(descriptor: str, key: str) -> int:
    match = re.search(rf':ignatius\.chain/{re.escape(key)}\s+([0-9]+)', descriptor)
    if match is None:
        raise SystemExit(f"db/chain-release.edn has no {key}")
    return int(match.group(1))


def add_file(archive: zipfile.ZipFile, root: Path, relative: str) -> None:
    source = root / relative
    info = zipfile.ZipInfo(relative, date_time=(1980, 1, 1, 0, 0, 0))
    info.compress_type = zipfile.ZIP_STORED
    info.create_system = 3
    info.external_attr = 0o100644 << 16
    archive.writestr(info, source.read_bytes())


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    output = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else root / "dist"
    output.mkdir(parents=True, exist_ok=True)

    descriptor = (root / "db/chain-release.edn").read_text(encoding="utf-8")
    version = release_version(descriptor)
    schema_version = descriptor_integer(descriptor, "schema-version")
    protocol_version = descriptor_integer(descriptor, "protocol-version")
    stem = f"ignatius-postgres-chain-v{version}"
    archive_path = output / f"{stem}.zip"
    migration_files = sorted(
        path.relative_to(root).as_posix()
        for path in (root / "db/migrations").glob("[0-9][0-9][0-9][0-9]-*.sql")
    )
    files = sorted((*RELEASE_FILES, *migration_files))

    with zipfile.ZipFile(archive_path, "w") as archive:
        for relative in files:
            add_file(archive, root, relative)

    digest = hashlib.sha256(archive_path.read_bytes()).hexdigest()
    checksum_path = output / f"{stem}.zip.sha256"
    checksum_path.write_text(f"{digest}  {archive_path.name}\n", encoding="utf-8")
    metadata = {
        "artifact": archive_path.name,
        "releaseVersion": version,
        "schemaVersion": schema_version,
        "protocolVersion": protocol_version,
        "sha256": digest,
        "freshInstallDestructive": True,
        "migrationCount": len(migration_files),
        "files": files,
    }
    metadata_path = output / f"{stem}.json"
    metadata_path.write_text(
        json.dumps(metadata, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    print(archive_path)
    print(checksum_path)
    print(metadata_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
