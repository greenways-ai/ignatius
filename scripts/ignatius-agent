#!/usr/bin/env python3
"""Application command router for Ignatius Agent Workflow host operations."""

from __future__ import annotations

import os
import stat
import sys
from pathlib import Path
from typing import Sequence

COMMANDS = {"workflow-status": "ignatius-agent-workflow-status"}


def main(argv: Sequence[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if not arguments or arguments[0] not in COMMANDS:
        print("usage: ignatius-agent workflow-status [OPTIONS] ROLE=PATH ...", file=sys.stderr)
        return 2
    command = arguments.pop(0)
    target = Path(__file__).absolute().parent / COMMANDS[command]
    try:
        target_stat = target.lstat()
    except OSError:
        print("error: application command is unavailable", file=sys.stderr)
        return 2
    if stat.S_ISLNK(target_stat.st_mode) or not stat.S_ISREG(target_stat.st_mode):
        print("error: application command must be a regular non-symlink file", file=sys.stderr)
        return 2
    os.execv(str(target), [str(target), *arguments])
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
