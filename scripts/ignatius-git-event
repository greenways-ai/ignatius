#!/usr/bin/env python3
"""Emit unsigned Ignatius agent-workflow events from a Git checkout.

The ledger runtime injects signer, transaction, timestamp and previous-head
fields after signature verification. This adapter deliberately emits only the
payload that an agent signs.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable


@dataclass(frozen=True)
class Keyword:
    name: str


def keyword(value: str) -> Keyword:
    cleaned = value[1:] if value.startswith(":") else value
    if not cleaned:
        raise ValueError("keyword cannot be empty")
    return Keyword(cleaned)


def edn(value: Any) -> str:
    if isinstance(value, Keyword):
        return f":{value.name}"
    if value is None:
        return "nil"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, int):
        return str(value)
    if isinstance(value, list):
        return "[" + " ".join(edn(item) for item in value) + "]"
    if isinstance(value, dict):
        return (
            "{"
            + " ".join(
                f"{edn(key)} {edn(item)}" for key, item in value.items()
            )
            + "}"
        )
    raise TypeError(f"unsupported EDN value: {type(value).__name__}")


def run_git(repo: Path, *args: str, allow_failure: bool = False) -> str:
    process = subprocess.run(
        ["git", "-C", str(repo), *args],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if process.returncode != 0:
        if allow_failure:
            return ""
        message = process.stderr.strip() or process.stdout.strip()
        raise RuntimeError(f"git {' '.join(args)} failed: {message}")
    return process.stdout.strip()


def git_repository(repo: Path) -> dict[str, Any]:
    top = Path(run_git(repo, "rev-parse", "--show-toplevel"))
    commit = run_git(top, "rev-parse", "HEAD")
    tree = run_git(top, "rev-parse", "HEAD^{tree}")
    parents = run_git(top, "show", "-s", "--format=%P", "HEAD").split()
    remote = run_git(
        top, "config", "--get", "remote.origin.url", allow_failure=True
    )
    ref = run_git(
        top, "symbolic-ref", "-q", "HEAD", allow_failure=True
    ) or f"detached/{commit}"
    object_format = run_git(
        top, "rev-parse", "--show-object-format", allow_failure=True
    ) or "sha1"
    dirty = bool(run_git(top, "status", "--porcelain"))
    return {
        "top": top,
        "commit": commit,
        "tree": tree,
        "parents": parents,
        "remote": remote,
        "ref": ref,
        "object_format": object_format,
        "dirty": dirty,
    }


def logical_reference(
    workspace_id: str, resource_id: str, version: str
) -> dict[Any, Any]:
    return {
        keyword("record/type"): keyword("reference/logical"),
        keyword("record/version"): 1,
        keyword("record/extensions"): {},
        keyword("reference/scope-id"): workspace_id,
        keyword("reference/kind"): keyword("resource/version"),
        keyword("reference/id"): resource_id,
        keyword("reference/root"): version,
        keyword("reference/metadata"): {},
    }


def parse_reference(
    workspace_id: str, value: str
) -> dict[Any, Any]:
    if "=" not in value:
        raise argparse.ArgumentTypeError(
            "resource references must use RESOURCE_ID=VERSION"
        )
    resource_id, version = value.split("=", 1)
    if not resource_id or not version:
        raise argparse.ArgumentTypeError(
            "resource references require both RESOURCE_ID and VERSION"
        )
    return logical_reference(workspace_id, resource_id, version)


def event_base(action: str, workspace_id: str) -> dict[Any, Any]:
    return {
        keyword("action"): keyword(action),
        keyword("workspace/id"): workspace_id,
    }


def resource_event(args: argparse.Namespace) -> dict[Any, Any]:
    repo = Path(args.repo).resolve()
    details = git_repository(repo)
    if details["dirty"] and not args.allow_dirty:
        raise RuntimeError(
            "working tree is dirty; commit or pass --allow-dirty"
        )

    if args.initial:
        previous = None
    elif args.previous_version is not None:
        previous = args.previous_version
    else:
        previous = details["parents"][0] if details["parents"] else None

    event = event_base("resource/register", args.workspace)
    event.update(
        {
            keyword("resource/id"): args.resource_id,
            keyword("resource/kind"): keyword("git/commit"),
            keyword("resource/provider"): keyword(args.provider),
            keyword("resource/version"): details["commit"],
            keyword("resource/previous-version"): previous,
            keyword("resource/parent-versions"): details["parents"],
            keyword("resource/locator"): {
                keyword("git/repository"): details["remote"],
                keyword("git/ref"): details["ref"],
                keyword("git/tree"): details["tree"],
            },
            keyword("resource/digest-algorithm"): keyword(
                f"git/{details['object_format']}"
            ),
            keyword("resource/digest"): details["commit"],
            keyword("resource/metadata"): {
                keyword("git/dirty"): details["dirty"],
            },
        }
    )
    if args.process_id:
        event[keyword("process/id")] = args.process_id
    return event


def create_work_event(args: argparse.Namespace) -> dict[Any, Any]:
    event = event_base("work/create", args.workspace)
    event.update(
        {
            keyword("work/id"): args.work_id,
            keyword("work/kind"): keyword(args.kind),
            keyword("work/title"): args.title,
            keyword("work/definition-root"): args.definition_root,
            keyword("work/dependency-ids"): list(args.dependency),
            keyword("work/input-references"): [
                parse_reference(args.workspace, value)
                for value in args.input
            ],
            keyword("work/metadata"): {},
        }
    )
    return event


def simple_work_event(
    action: str, args: argparse.Namespace
) -> dict[Any, Any]:
    event = event_base(action, args.workspace)
    event[keyword("work/id")] = args.work_id
    return event


def checkpoint_event(args: argparse.Namespace) -> dict[Any, Any]:
    event = simple_work_event("work/checkpoint", args)
    event.update(
        {
            keyword("checkpoint/id"): args.checkpoint_id,
            keyword("checkpoint/state-root"): args.state_root,
            keyword("checkpoint/resource-references"): [
                parse_reference(args.workspace, value)
                for value in args.output
            ],
            keyword("checkpoint/receipt-root"): args.receipt_root,
            keyword("checkpoint/metadata"): {},
        }
    )
    return event


def complete_event(args: argparse.Namespace) -> dict[Any, Any]:
    event = simple_work_event("work/complete", args)
    event.update(
        {
            keyword("work/output-references"): [
                parse_reference(args.workspace, value)
                for value in args.output
            ],
            keyword("work/result-root"): args.result_root,
            keyword("work/receipt-root"): args.receipt_root,
        }
    )
    return event


def add_workspace_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--workspace",
        required=True,
        help="stable Ignatius workspace ID",
    )


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description="Emit unsigned Ignatius workflow event payloads"
    )
    commands = root.add_subparsers(dest="command", required=True)

    resource = commands.add_parser(
        "resource", help="pin the current Git commit as a resource version"
    )
    add_workspace_argument(resource)
    resource.add_argument("--resource-id", required=True)
    resource.add_argument("--repo", default=".")
    resource.add_argument("--provider", default="git")
    resource.add_argument("--process-id")
    resource.add_argument("--previous-version")
    resource.add_argument("--initial", action="store_true")
    resource.add_argument("--allow-dirty", action="store_true")
    resource.set_defaults(build=resource_event)

    create = commands.add_parser(
        "work-create", help="create a dependency-aware work item"
    )
    add_workspace_argument(create)
    create.add_argument("--work-id", required=True)
    create.add_argument("--kind", default="agent/task")
    create.add_argument("--title", required=True)
    create.add_argument("--definition-root", required=True)
    create.add_argument("--dependency", action="append", default=[])
    create.add_argument(
        "--input",
        action="append",
        default=[],
        metavar="RESOURCE_ID=VERSION",
    )
    create.set_defaults(build=create_work_event)

    for name, action in [
        ("work-claim", "work/claim"),
        ("work-start", "work/start"),
    ]:
        command = commands.add_parser(name)
        add_workspace_argument(command)
        command.add_argument("--work-id", required=True)
        command.set_defaults(
            build=lambda args, action=action: simple_work_event(action, args)
        )

    checkpoint = commands.add_parser(
        "work-checkpoint", help="record a durable agent checkpoint"
    )
    add_workspace_argument(checkpoint)
    checkpoint.add_argument("--work-id", required=True)
    checkpoint.add_argument("--checkpoint-id", required=True)
    checkpoint.add_argument("--state-root", required=True)
    checkpoint.add_argument(
        "--output",
        action="append",
        default=[],
        metavar="RESOURCE_ID=VERSION",
    )
    checkpoint.add_argument("--receipt-root")
    checkpoint.set_defaults(build=checkpoint_event)

    complete = commands.add_parser(
        "work-complete", help="complete work with exact external outputs"
    )
    add_workspace_argument(complete)
    complete.add_argument("--work-id", required=True)
    complete.add_argument(
        "--output",
        action="append",
        default=[],
        metavar="RESOURCE_ID=VERSION",
    )
    complete.add_argument("--result-root")
    complete.add_argument("--receipt-root")
    complete.set_defaults(build=complete_event)

    return root


def main(argv: Iterable[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        payload = args.build(args)
    except (RuntimeError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    print(edn(payload))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
