#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  echo "error: run this command from an Ignatius checkout" >&2
  exit 1
fi

HARA_REPOSITORY="https://github.com/hara-lang/hara.git"
HARA_REVISION="d305875e3bfe3d8fc4f8a1462053e4ca901aaa74"
FOUNDATION_REPOSITORY="https://github.com/zcaudate-xyz/foundation-base.git"
FOUNDATION_REVISION="baa75aabd6a879753d7d5cb07271b1448271e7cb"

checkout_revision() {
  local repository="$1"
  local revision="$2"
  local checkout="$3"

  if [[ -d "$checkout/.git" ]]; then
    if [[ -n "$(git -C "$checkout" status --porcelain)" ]]; then
      echo "error: dependency checkout has local changes: $checkout" >&2
      exit 1
    fi
  else
    rm -rf "$checkout"
    mkdir -p "$(dirname "$checkout")"
    git clone --filter=blob:none --no-checkout "$repository" "$checkout"
  fi

  git -C "$checkout" fetch --depth 1 origin "$revision"
  git -C "$checkout" checkout --detach --force "$revision"
}

install_hara_layout_compatibility() {
  local checkout="$1"
  local manifest="$checkout/core/rust/Cargo.toml"
  local legacy="$checkout/rust"
  local exclude

  if [[ ! -f "$manifest" ]]; then
    echo "error: pinned Hara checkout has no core/rust/Cargo.toml" >&2
    exit 1
  fi

  # Ignatius Verify historically consumed the Hara CLI at rust/. The current
  # Hara repository moved that workspace to core/rust/. Keep one ignored local
  # alias while downstream build consumers migrate without dirtying the pinned
  # dependency checkout.
  exclude="$(git -C "$checkout" rev-parse --git-path info/exclude)"
  mkdir -p "$(dirname "$exclude")"
  if ! grep -qxF '/rust' "$exclude" 2>/dev/null; then
    printf '/rust\n' >> "$exclude"
  fi

  if [[ -e "$legacy" && ! -L "$legacy" ]]; then
    echo "error: Hara compatibility path exists and is not a symlink: $legacy" >&2
    exit 1
  fi
  ln -sfn core/rust "$legacy"
}

checkout_revision \
  "$HARA_REPOSITORY" \
  "$HARA_REVISION" \
  "$repo_root/.local/hara.lang"
install_hara_layout_compatibility "$repo_root/.local/hara.lang"

checkout_revision \
  "$FOUNDATION_REPOSITORY" \
  "$FOUNDATION_REVISION" \
  "$repo_root/db/checkouts/foundation"

printf 'Hara:       %s\n' "$(git -C "$repo_root/.local/hara.lang" rev-parse HEAD)"
printf 'Foundation: %s\n' "$(git -C "$repo_root/db/checkouts/foundation" rev-parse HEAD)"
