#!/usr/bin/env python3
"""Verify GitHub webhooks and emit unsigned provider-neutral Ignatius events."""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import sys
from pathlib import Path
from typing import Iterable

from ignatius_github_check import completed_check_events
from ignatius_github_common import edn, parse_json, require_string, verify_signature
from ignatius_github_issue import opened_events, update_events
from ignatius_github_outbox import record_delivery
from ignatius_github_pull import proposal_events
from ignatius_github_pull_lifecycle import lifecycle_events
from ignatius_github_push import push_events

MAX_PAYLOAD_BYTES = 10 * 1024 * 1024
MAX_ENRICHMENT_BYTES = 2 * 1024 * 1024
_ISSUE_VERSION = re.compile(r"^sha256:[0-9a-f]{64}$")
_UPDATE_COMMANDS = {
    "issue-edited": "edited",
    "issue-reopened": "reopened",
    "issue-closed": "closed",
}


def _common_arguments(command: argparse.ArgumentParser) -> None:
    command.add_argument("--workspace", required=True)
    command.add_argument("--repository", required=True, help="expected owner/repository")
    command.add_argument("--delivery-id", required=True)
    command.add_argument("--payload", default="-")
    command.add_argument("--signature", required=True)
    command.add_argument("--secret-env", default="GITHUB_WEBHOOK_SECRET")
    command.add_argument("--outbox-db")


def _version_arguments(command: argparse.ArgumentParser) -> None:
    version = command.add_mutually_exclusive_group(required=True)
    version.add_argument("--initial", action="store_true")
    version.add_argument("--previous-version")


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    commands = root.add_subparsers(dest="command", required=True)

    opened = commands.add_parser("issue-opened")
    _common_arguments(opened)
    opened.add_argument("--definition-root", required=True)
    opened.add_argument("--dependency-work-id", action="append", default=[])
    _version_arguments(opened)

    for name in _UPDATE_COMMANDS:
        update = commands.add_parser(name)
        _common_arguments(update)
        update.add_argument("--previous-version", required=True)

    push = commands.add_parser("push")
    _common_arguments(push)
    push.add_argument(
        "--commit-object",
        required=True,
        help="JSON returned by GitHub's Get a commit object endpoint",
    )
    push.add_argument("--process-id")
    _version_arguments(push)

    check = commands.add_parser("check-completed")
    _common_arguments(check)
    check.add_argument("--work-id", required=True)
    check.add_argument("--commit-resource-id", required=True)
    check.add_argument("--commit-version", required=True)
    _version_arguments(check)

    proposal = commands.add_parser("pull-request-proposal")
    _common_arguments(proposal)
    proposal.add_argument("--candidate-root", required=True)
    proposal.add_argument("--origin-root", required=True)
    _version_arguments(proposal)

    lifecycle = commands.add_parser("pull-request-lifecycle")
    _common_arguments(lifecycle)
    lifecycle.add_argument("--candidate-root", required=True)
    lifecycle.add_argument("--origin-root", required=True)
    lifecycle.add_argument("--previous-version", required=True)
    return root


def read_bytes(path: str, *, maximum: int, label: str) -> bytes:
    body = sys.stdin.buffer.read() if path == "-" else Path(path).read_bytes()
    if len(body) > maximum:
        raise ValueError(f"{label} exceeds {maximum} bytes")
    return body


def _validate_args(args: argparse.Namespace) -> None:
    require_string(args.workspace, "--workspace")
    require_string(args.repository, "--repository")
    require_string(args.delivery_id, "--delivery-id")
    if len(args.delivery_id) > 255:
        raise ValueError("--delivery-id exceeds 255 characters")
    previous = getattr(args, "previous_version", None)
    if (
        args.command.startswith("issue-")
        or args.command
        in {"check-completed", "pull-request-proposal", "pull-request-lifecycle"}
    ) and previous is not None:
        if not _ISSUE_VERSION.fullmatch(previous):
            raise ValueError(
                "--previous-version must be sha256:<64 lowercase hex characters>"
            )
    if args.command == "issue-opened":
        require_string(args.definition_root, "--definition-root")


def main(argv: Iterable[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        _validate_args(args)
        secret = os.environ.get(args.secret_env)
        if not secret:
            raise ValueError(
                f"webhook secret environment variable {args.secret_env!r} is missing"
            )
        body = read_bytes(
            args.payload,
            maximum=MAX_PAYLOAD_BYTES,
            label="GitHub webhook payload",
        )
        verify_signature(body, args.signature, secret)
        payload = parse_json(body)
        if args.command == "issue-opened":
            result = opened_events(
                payload,
                workspace=args.workspace,
                expected_repository=args.repository,
                definition_root=args.definition_root,
                delivery_id=args.delivery_id,
                dependencies=args.dependency_work_id,
                previous_version=None if args.initial else args.previous_version,
            )
        elif args.command in _UPDATE_COMMANDS:
            result = update_events(
                payload,
                action=_UPDATE_COMMANDS[args.command],
                workspace=args.workspace,
                expected_repository=args.repository,
                delivery_id=args.delivery_id,
                previous_version=args.previous_version,
            )
        elif args.command == "push":
            commit_object = parse_json(
                read_bytes(
                    args.commit_object,
                    maximum=MAX_ENRICHMENT_BYTES,
                    label="GitHub commit object",
                )
            )
            result = push_events(
                payload,
                commit_object,
                workspace=args.workspace,
                expected_repository=args.repository,
                delivery_id=args.delivery_id,
                previous_version=None if args.initial else args.previous_version,
                process_id=args.process_id,
            )
        elif args.command == "check-completed":
            result = completed_check_events(
                payload,
                workspace=args.workspace,
                expected_repository=args.repository,
                delivery_id=args.delivery_id,
                work_id=args.work_id,
                commit_resource_id=args.commit_resource_id,
                commit_version=args.commit_version,
                previous_version=None if args.initial else args.previous_version,
            )
        elif args.command == "pull-request-lifecycle":
            result = lifecycle_events(
                payload,
                workspace=args.workspace,
                expected_repository=args.repository,
                delivery_id=args.delivery_id,
                candidate_root=args.candidate_root,
                origin_root=args.origin_root,
                previous_version=args.previous_version,
            )
        else:
            result = proposal_events(
                payload,
                workspace=args.workspace,
                expected_repository=args.repository,
                delivery_id=args.delivery_id,
                candidate_root=args.candidate_root,
                origin_root=args.origin_root,
                previous_version=None if args.initial else args.previous_version,
            )
        if args.outbox_db:
            record_delivery(
                args.outbox_db,
                delivery_id=args.delivery_id,
                body=body,
                snapshot_version=result.snapshot_version,
                snapshot_json=result.snapshot_json,
                events=result.events,
            )
    except (OSError, ValueError, TypeError, json.JSONDecodeError, sqlite3.Error) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    print(edn(result.events))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
