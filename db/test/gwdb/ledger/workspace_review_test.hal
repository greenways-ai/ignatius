(ns gwdb.ledger.workspace-review-test
  (:use code.test)
  (:require [lang.core :as l]
            [postgres.core :as pg]
            [gwdb.ledger.base :as base]
            [gwdb.ledger.admission :as admission]
            [gwdb.ledger.developer :as developer]
            [gwdb.ledger.scoped-ref :as scoped-ref]
            [gwdb.ledger.value :as value]
            [gwdb.ledger.workspace :as workspace]
            [gwdb.ledger.workspace-admission :as workspace-admission]
            [gwdb.ledger.workspace-proposal :as workspace-proposal]
            [gwdb.ledger.workspace-review :as workspace-review]))

(l/script- :postgres
  {:runtime :db.client
   :config {:dbname "gw-ledger-test"
            :temp :create
            :container {:group "gw-ledger"
                        :image "gw-ledger-postgres:15-pgsodium"
                        :ports [5432]
                        :environment {"POSTGRES_PASSWORD" "postgres"
                                      "POSTGRES_USER" "postgres"
                                      "POSTGRES_HOST_AUTH_METHOD" "md5"
                                      "IGNATIUS_PGSODIUM_ROOT_KEY"
                                      "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"}
                        :cmd ["postgres" "-c" "password_encryption=md5"]}}
   :require [[postgres.core :as pg]
             [gwdb.ledger.base :as base :primary true]
             [gwdb.ledger.admission :as admission]
             [gwdb.ledger.developer :as developer]
             [gwdb.ledger.scoped-ref :as scoped-ref]
             [gwdb.ledger.value :as value]
             [gwdb.ledger.workspace :as workspace]
             [gwdb.ledger.workspace-admission :as workspace-admission]
             [gwdb.ledger.workspace-proposal :as workspace-proposal]
             [gwdb.ledger.workspace-review :as workspace-review]]
   :static {:application ["gw"]
            :seed ["gw_ledger"]
            :all {:schema ["gw_ledger"]}}})

(fact:global
 {:setup [(l/rt:stop)
          (l/rt:restart)]
  :teardown [(l/rt:stop)
             (l/rt:stop)]})

(defn hex-bytes
  [text]
  (.parseHex (java.util.HexFormat/of) text))

(defn bytes-hex
  [bytes]
  (.formatHex (java.util.HexFormat/of) bytes))

(defn json-field
  [value field]
  (or (get value field)
      (get value (keyword field))))

(def +private-seed+
  "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")

(def +public-key+
  "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")

(defn sign-payload
  [payload-hex]
  (let [spec
        (java.security.spec.EdECPrivateKeySpec.
         java.security.spec.NamedParameterSpec/ED25519
         (hex-bytes +private-seed+))
        factory (java.security.KeyFactory/getInstance "Ed25519")
        private-key (.generatePrivate factory spec)
        signer (java.security.Signature/getInstance "Ed25519")]
    (.initSign signer private-key)
    (.update signer (hex-bytes payload-hex))
    (bytes-hex (.sign signer))))

(defn.pg ^{:- [:bytea]}
  author-evidence
  {:added "0.14"}
  [:bytea i-signer-root]
  (let [(:bytea v-record)
        (workspace/record-start "ledger/evidence")
        (:bytea v-version)
        (workspace/record-assoc
         v-record "record/version" (value/put-integer-number 1))
        (:bytea v-extensions)
        (workspace/record-assoc
         v-version "record/extensions"
         (value/put-map (pg/jsonb-build-array)))
        (:bytea v-signer)
        (workspace/record-assoc
         v-extensions "ledger/signer" i-signer-root)
        (:bytea v-transaction)
        (workspace/record-assoc
         v-signer "ledger/transaction-root" (value/put-nil))
        (:bytea v-timestamp)
        (workspace/record-assoc
         v-transaction "ledger/timestamp"
         (value/put-integer-number 1))
        (:bytea v-head)
        (workspace/record-assoc
         v-timestamp "ledger/previous-head-root" (value/put-nil))
        (:bytea v-contract)
        (workspace/record-assoc
         v-head "ledger/contract-root" (value/put-nil))
        (:bytea v-template)
        (workspace/record-assoc
         v-contract "ledger/template-root" (value/put-nil))]
    (return
     (workspace/record-assoc
      v-template "ledger/global-state-root" (value/put-nil)))))

(defn.pg ^{:- [:bytea]}
  root-vector
  {:added "0.14"}
  [:jsonb i-roots]
  (return (value/put-vector i-roots)))

(defn.pg ^{:- [:jsonb]}
  review-fixture
  "Builds and publishes one reviewable candidate."
  {:added "0.14"}
  [:bytea i-public-key]
  (let [(:bytea v-address)
        (admission/admission-address-root i-public-key)
        (:bytea v-evidence) (-/author-evidence v-address)
        (:bytea v-workspace)
        (value/put-string "world/orbital-station")
        (:bytea v-empty-map)
        (value/put-map (pg/jsonb-build-array))
        (:bytea v-c0)
        (workspace/workspace-commit-put
         v-workspace nil
         (-/root-vector (pg/jsonb-build-array))
         (value/put-string "W0")
         nil nil nil v-evidence nil v-empty-map v-empty-map)
        (:bytea v-c1)
        (workspace/workspace-commit-put
         v-workspace nil
         (-/root-vector
          (pg/jsonb-build-array (pg/encode v-c0 "hex")))
         (value/put-string "W1")
         (value/put-string "edit-1")
         nil nil v-evidence nil v-empty-map v-empty-map)]
    (return
     (pg/jsonb-build-object
      "workspace_id_root" (pg/encode v-workspace "hex")
      "candidate_root" (pg/encode v-c1 "hex")))))

^{:refer gwdb.ledger.workspace-review/workspace-review-submit :added "0.14"}
(fact "signed reviewer decisions update one reviewer ref through exact CAS"
  (let [network "workspace-reviews"
        public-key (hex-bytes +public-key+)
        _ (developer/developer-genesis network 0)
        registration-request
        (admission/admission-registration-signing-request
         network public-key)
        registration-signature
        (hex-bytes
         (sign-payload
          (json-field registration-request "signing_payload")))
        registration
        (admission/admission-register-account
         network public-key registration-signature 1)
        address-hex (json-field registration "address")
        address-root (hex-bytes address-hex)
        fixture (-/review-fixture public-key)
        workspace-id-root
        (hex-bytes (json-field fixture "workspace_id_root"))
        candidate-root
        (hex-bytes (json-field fixture "candidate_root"))

        proposal-request
        (workspace-proposal/workspace-proposal-signing-request
         network public-key workspace-id-root candidate-root 20)
        proposal-signature
        (hex-bytes
         (sign-payload
          (json-field proposal-request "signing_payload")))
        proposal-result
        (workspace-proposal/workspace-proposal-submit
         network public-key
         (long (json-field proposal-request "sequence"))
         workspace-id-root candidate-root 20 proposal-signature 2)

        approve-request
        (workspace-review/workspace-review-signing-request
         network public-key workspace-id-root candidate-root
         nil "approve" 3 20)
        approve-signature
        (hex-bytes
         (sign-payload
          (json-field approve-request "signing_payload")))
        approve-result
        (workspace-review/workspace-review-submit
         network public-key
         (long (json-field approve-request "sequence"))
         workspace-id-root candidate-root nil
         "approve" 3 20 approve-signature)
        approve-root
        (hex-bytes (json-field approve-result "review_root"))

        stale-request
        (workspace-review/workspace-review-signing-request
         network public-key workspace-id-root candidate-root
         nil "reject" 4 20)
        stale-signature
        (hex-bytes
         (sign-payload
          (json-field stale-request "signing_payload")))
        stale-result
        (workspace-review/workspace-review-submit
         network public-key
         (long (json-field stale-request "sequence"))
         workspace-id-root candidate-root nil
         "reject" 4 20 stale-signature)

        reject-request
        (workspace-review/workspace-review-signing-request
         network public-key workspace-id-root candidate-root
         approve-root "reject" 5 20)
        reject-signature
        (hex-bytes
         (sign-payload
          (json-field reject-request "signing_payload")))
        reject-result
        (workspace-review/workspace-review-submit
         network public-key
         (long (json-field reject-request "sequence"))
         workspace-id-root candidate-root approve-root
         "reject" 5 20 reject-signature)
        reject-root
        (hex-bytes (json-field reject-result "review_root"))

        withdraw-request
        (workspace-review/workspace-review-signing-request
         network public-key workspace-id-root candidate-root
         reject-root "withdraw" 6 20)
        withdraw-signature
        (hex-bytes
         (sign-payload
          (json-field withdraw-request "signing_payload")))
        withdraw-result
        (workspace-review/workspace-review-submit
         network public-key
         (long (json-field withdraw-request "sequence"))
         workspace-id-root candidate-root reject-root
         "withdraw" 6 20 withdraw-signature)
        withdraw-root
        (hex-bytes (json-field withdraw-result "review_root"))

        replayed
        (try
          (workspace-review/workspace-review-submit
           network public-key
           (long (json-field withdraw-request "sequence"))
           workspace-id-root candidate-root reject-root
           "withdraw" 6 20 withdraw-signature)
          (catch Throwable _ :rejected))
        no-op
        (try
          (workspace-review/workspace-review-signing-request
           network public-key workspace-id-root candidate-root
           withdraw-root "withdraw" 6 20)
          (catch Throwable _ :rejected))
        scope (json-field withdraw-result "scope")
        name (json-field withdraw-result "name")
        review-read
        (scoped-ref/scoped-ref-read scope name address-root)
        proposal-read
        (scoped-ref/scoped-ref-read
         scope (workspace-proposal/proposal-name candidate-root)
         address-root)
        main-row (scoped-ref/scoped-ref-row scope "main")
        approve-row (workspace-review/workspace-review-row approve-root)
        reject-row (workspace-review/workspace-review-row reject-root)
        withdraw-row (workspace-review/workspace-review-row withdraw-root)
        head (developer/developer-head network)]
    [(json-field proposal-result "status")
     (json-field approve-result "status")
     (json-field approve-result "ref_version")
     (= (json-field approve-result "intent_root")
        (json-field approve-result "result_root"))
     (= (json-field approve-result "decision") "approve")
     (= (json-field stale-result "status") "conflict")
     (= (json-field stale-result "actual_root")
        (bytes-hex approve-root))
     (json-field reject-request "sequence")
     (json-field reject-result "status")
     (json-field reject-result "ref_version")
     (= (json-field reject-result "decision") "reject")
     (= (json-field withdraw-result "status") "ok")
     (json-field withdraw-result "ref_version")
     (= (json-field withdraw-result "decision") "withdraw")
     (= (json-field withdraw-result "intent_root")
        (json-field withdraw-result "result_root"))
     (= name
        (str "review/" (bytes-hex candidate-root)
             "/" address-hex))
     (= (json-field review-read "root")
        (bytes-hex withdraw-root))
     (= (json-field proposal-read "root")
        (bytes-hex candidate-root))
     (nil? main-row)
     (workspace-review/workspace-review-valid approve-root)
     (workspace-review/workspace-review-valid reject-root)
     (workspace-review/workspace-review-valid withdraw-root)
     (= (json-field approve-row "decision") "approve")
     (= (json-field reject-row "decision") "reject")
     (= (json-field withdraw-row "decision") "withdraw")
     (= (long (json-field withdraw-row "recorded_at")) 6)
     (json-field head "height")
     replayed
     no-op
     (= address-hex (json-field withdraw-result "address"))])
  => ["ok" "ok" 1 true true
      true true 2
      "ok" 2 true
      true 3 true true true
      true true true
      true true true true true true true
      5 :rejected :rejected true])


(def legacy-results (code.test/run {}))

(std.lib.test/print-results
 [(std.lib.test/check "ported Foundation facts pass"
                      (:status legacy-results)
                      :passed)])
