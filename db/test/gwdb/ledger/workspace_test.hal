(ns gwdb.ledger.workspace-test
  (:use code.test)
  (:require [lang.core :as l]
            [postgres.core :as pg]
            [gwdb.ledger.base :as base]
            [gwdb.ledger.workspace :as workspace]
            [gwdb.ledger.value :as value]))

(l/script- :postgres
  {:runtime :db.client
   :config {:dbname "gw-ledger-test"
            :temp :create
            :container {:group "gw-ledger"
                        :image "gw-ledger-postgres:15-pgsodium"
                        :ports [5432]
                        :environment {"POSTGRES_PASSWORD" "postgres"
                                      "POSTGRES_USER" "postgres"
                                      "POSTGRES_HOST_AUTH_METHOD" "md5"
                                      "IGNATIUS_PGSODIUM_ROOT_KEY"
                                      "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"}
                        :cmd ["postgres" "-c" "password_encryption=md5"]}}
   :require [[postgres.core :as pg]
             [gwdb.ledger.base :as base :primary true]
             [gwdb.ledger.workspace :as workspace]
             [gwdb.ledger.value :as value]]
   :static {:application ["gw"]
            :seed ["gw_ledger"]
            :all {:schema ["gw_ledger"]}}})

(fact:global
 {:setup [(l/rt:stop)
          (l/rt:restart)]
  :teardown [(l/rt:stop)
             (l/rt:stop)]})

(defn.pg ^{:- [:bytea]}
  author-evidence
  {:added "0.11"}
  [:bytea i-signer-root]
  (let [(:bytea v-record)
        (workspace/record-start "ledger/evidence")
        (:bytea v-version)
        (workspace/record-assoc
         v-record "record/version" (value/put-integer-number 1))
        (:bytea v-extensions)
        (workspace/record-assoc
         v-version "record/extensions"
         (value/put-map (pg/jsonb-build-array)))
        (:bytea v-signer)
        (workspace/record-assoc
         v-extensions "ledger/signer" i-signer-root)
        (:bytea v-transaction)
        (workspace/record-assoc
         v-signer "ledger/transaction-root" (value/put-nil))
        (:bytea v-timestamp)
        (workspace/record-assoc
         v-transaction "ledger/timestamp"
         (value/put-integer-number 1700000000))
        (:bytea v-head)
        (workspace/record-assoc
         v-timestamp "ledger/previous-head-root" (value/put-nil))
        (:bytea v-contract)
        (workspace/record-assoc
         v-head "ledger/contract-root" (value/put-nil))
        (:bytea v-template)
        (workspace/record-assoc
         v-contract "ledger/template-root" (value/put-nil))]
    (return
     (workspace/record-assoc
      v-template "ledger/global-state-root" (value/put-nil)))))

(defn.pg ^{:- [:bytea]}
  root-vector
  {:added "0.11"}
  [:jsonb i-roots]
  (return (value/put-vector i-roots)))

(defn.pg ^{:- [:bytea]}
  candidate-value
  {:added "0.11"}
  [:bytea i-workspace-id-root
   :jsonb i-parent-roots
   :bytea i-state-root
   :bytea i-merge-base-root
   :bytea i-merge-policy-root
   :bytea i-author-root]
  (return
   (workspace/workspace-commit-value
    i-workspace-id-root
    nil
    (-/root-vector i-parent-roots)
    i-state-root
    (pg/case (== (pg/jsonb-array-length i-parent-roots) 0)
             nil
             :else (value/put-string "operation"))
    i-merge-base-root
    i-merge-policy-root
    i-author-root
    nil
    (value/put-map (pg/jsonb-build-array))
    (value/put-map (pg/jsonb-build-array)))))

(defn.pg ^{:- [:jsonb]}
  run-workspace-demo
  {:added "0.11"}
  []
  (let [_ (pg/t:delete workspace/WorkspaceCommitParent)
        _ (pg/t:delete workspace/WorkspaceCommit)
        (:bytea v-workspace) (value/put-string "world/orbital-station")
        (:bytea v-other-workspace) (value/put-string "world/other")
        (:bytea v-author) (value/put-symbol "account/alice")
        (:bytea v-evidence) (-/author-evidence v-author)
        (:bytea v-empty-map) (value/put-map (pg/jsonb-build-array))
        (:bytea v-c10)
        (workspace/workspace-commit-put
         v-workspace nil
         (-/root-vector (pg/jsonb-build-array))
         (value/put-string "W47")
         nil nil nil v-evidence nil v-empty-map v-empty-map)
        (:bytea v-ca)
        (workspace/workspace-commit-put
         v-workspace nil
         (-/root-vector
          (pg/jsonb-build-array (pg/encode v-c10 "hex")))
         (value/put-string "WA")
         (value/put-string "move-fountain")
         nil nil v-evidence nil v-empty-map v-empty-map)
        (:bytea v-cb)
        (workspace/workspace-commit-put
         v-workspace nil
         (-/root-vector
          (pg/jsonb-build-array (pg/encode v-c10 "hex")))
         (value/put-string "WB")
         (value/put-string "change-material")
         nil nil v-evidence nil v-empty-map v-empty-map)
        (:bytea v-o1)
        (workspace/workspace-commit-put
         v-workspace nil
         (-/root-vector (pg/jsonb-build-array))
         (value/put-string "WO")
         nil nil nil v-evidence nil v-empty-map v-empty-map)
        (:bytea v-x0)
        (workspace/workspace-commit-put
         v-other-workspace nil
         (-/root-vector (pg/jsonb-build-array))
         (value/put-string "WX")
         nil nil nil v-evidence nil v-empty-map v-empty-map)
        (:bytea v-merge-policy) (value/put-string "scene-merge-policy-v1")
        (:bytea v-cm)
        (workspace/workspace-commit-put
         v-workspace nil
         (-/root-vector
          (pg/jsonb-build-array
           (pg/encode v-ca "hex")
           (pg/encode v-cb "hex")))
         (value/put-string "WM")
         (value/put-string "merge3")
         v-c10 v-merge-policy v-evidence nil v-empty-map v-empty-map)
        (:bytea v-missing-parent)
        (value/put-string "unknown-parent")
        (:bytea v-missing-candidate)
        (-/candidate-value
         v-workspace
         (pg/jsonb-build-array (pg/encode v-missing-parent "hex"))
         (value/put-string "W-missing") nil nil v-evidence)
        (:bytea v-duplicate-candidate)
        (-/candidate-value
         v-workspace
         (pg/jsonb-build-array
          (pg/encode v-ca "hex")
          (pg/encode v-ca "hex"))
         (value/put-string "W-duplicate") v-c10 v-merge-policy v-evidence)
        (:bytea v-cross-candidate)
        (-/candidate-value
         v-workspace
         (pg/jsonb-build-array (pg/encode v-x0 "hex"))
         (value/put-string "W-cross") nil nil v-evidence)
        (:bytea v-invalid-base-candidate)
        (-/candidate-value
         v-workspace
         (pg/jsonb-build-array
          (pg/encode v-ca "hex")
          (pg/encode v-cb "hex"))
         (value/put-string "W-bad-base") v-o1 v-merge-policy v-evidence)
        (:bytea v-no-policy-candidate)
        (-/candidate-value
         v-workspace
         (pg/jsonb-build-array
          (pg/encode v-ca "hex")
          (pg/encode v-cb "hex"))
         (value/put-string "W-no-policy") v-c10 nil v-evidence)
        (:bytea v-edit-merge-candidate)
        (-/candidate-value
         v-workspace
         (pg/jsonb-build-array (pg/encode v-c10 "hex"))
         (value/put-string "W-edit-merge") v-c10 v-merge-policy v-evidence)
        (:bytea v-invalid-author)
        (value/put-map (pg/jsonb-build-array))
        (:bytea v-invalid-author-candidate)
        (-/candidate-value
         v-workspace
         (pg/jsonb-build-array (pg/encode v-c10 "hex"))
         (value/put-string "W-invalid-author") nil nil v-invalid-author)
        (:bigint v-count) (pg/t:count workspace/WorkspaceCommit {})]
    (return
     (pg/jsonb-build-object
      "commit_count" v-count
      "c10_valid" (workspace/workspace-commit-valid v-c10)
      "ca_valid" (workspace/workspace-commit-valid v-ca)
      "cb_valid" (workspace/workspace-commit-valid v-cb)
      "cm_valid" (workspace/workspace-commit-valid v-cm)
      "cm_parent_count" (workspace/workspace-commit-parent-count v-cm)
      "cm_parent_0"
      (pg/encode (workspace/workspace-commit-parent-root v-cm 0) "hex")
      "ca_hex" (pg/encode v-ca "hex")
      "base_ancestor_ca"
      (workspace/workspace-commit-ancestor v-c10 v-ca)
      "base_ancestor_cb"
      (workspace/workspace-commit-ancestor v-c10 v-cb)
      "base_ancestor_merge"
      (workspace/workspace-commit-ancestor v-c10 v-cm)
      "sibling_ca_cb"
      (workspace/workspace-commit-ancestor v-ca v-cb)
      "merge_ancestor_ca"
      (workspace/workspace-commit-ancestor v-cm v-ca)
      "idempotent"
      (== (workspace/workspace-commit-import v-cm) v-cm)
      "missing_parent_error"
      (workspace/workspace-commit-error v-missing-candidate)
      "duplicate_parent_error"
      (workspace/workspace-commit-error v-duplicate-candidate)
      "cross_workspace_error"
      (workspace/workspace-commit-error v-cross-candidate)
      "invalid_base_error"
      (workspace/workspace-commit-error v-invalid-base-candidate)
      "missing_policy_error"
      (workspace/workspace-commit-error v-no-policy-candidate)
      "edit_merge_error"
      (workspace/workspace-commit-error v-edit-merge-candidate)
      "invalid_author_error"
      (workspace/workspace-commit-error v-invalid-author-candidate)
      "merge_workspace_matches"
      (== (:bytea (:->> (workspace/workspace-commit-row v-cm)
                        "workspace_id_root"))
          v-workspace)
      "merge_state_matches"
      (== (:bytea (:->> (workspace/workspace-commit-row v-cm)
                        "state_root"))
          (value/put-string "WM")))))

^{:refer gwdb.ledger.workspace/workspace-commit-import :added "0.11"}
(fact "PostgreSQL validates and projects canonical workspace commit DAGs"
  (!.pg
   [:select (:->> (-/run-workspace-demo) "commit_count")]
   [:select (:->> (-/run-workspace-demo) "c10_valid")]
   [:select (:->> (-/run-workspace-demo) "ca_valid")]
   [:select (:->> (-/run-workspace-demo) "cb_valid")]
   [:select (:->> (-/run-workspace-demo) "cm_valid")]
   [:select (:->> (-/run-workspace-demo) "cm_parent_count")]
   [:select (:->> (-/run-workspace-demo) "cm_parent_0")]
   [:select (:->> (-/run-workspace-demo) "ca_hex")]
   [:select (:->> (-/run-workspace-demo) "base_ancestor_ca")]
   [:select (:->> (-/run-workspace-demo) "base_ancestor_cb")]
   [:select (:->> (-/run-workspace-demo) "base_ancestor_merge")]
   [:select (:->> (-/run-workspace-demo) "sibling_ca_cb")]
   [:select (:->> (-/run-workspace-demo) "merge_ancestor_ca")]
   [:select (:->> (-/run-workspace-demo) "idempotent")]
   [:select (:->> (-/run-workspace-demo) "missing_parent_error")]
   [:select (:->> (-/run-workspace-demo) "duplicate_parent_error")]
   [:select (:->> (-/run-workspace-demo) "cross_workspace_error")]
   [:select (:->> (-/run-workspace-demo) "invalid_base_error")]
   [:select (:->> (-/run-workspace-demo) "missing_policy_error")]
   [:select (:->> (-/run-workspace-demo) "edit_merge_error")]
   [:select (:->> (-/run-workspace-demo) "invalid_author_error")]
   [:select (:->> (-/run-workspace-demo) "merge_workspace_matches")]
   [:select (:->> (-/run-workspace-demo) "merge_state_matches")])
  => '(6 true true true true 2
       #1 #1
       true true true false false true
       "workspace/missing-parent-commit"
       "workspace/duplicate-parent-root"
       "workspace/parent-workspace-mismatch"
       "workspace/invalid-merge-base"
       "workspace/missing-merge-policy"
       "workspace/non-merge-has-merge-fields"
       "workspace/invalid-author-evidence"
       true true))


(def legacy-results (code.test/run {}))

(std.lib.test/print-results
 [(std.lib.test/check "ported Foundation facts pass"
                      (:status legacy-results)
                      :passed)])
