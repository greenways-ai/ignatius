(ns ignatius.workspace-release-test
  (:require
            [ignatius.record :as record]
            [ignatius.storage :as storage]
            [ignatius.workspace :as workspace]
            [ignatius.workspace-acceptance :as acceptance]
            [ignatius.workspace-release :as release]))

(def workspace-id "world/orbital-station")
(def authority-root "account/alice")
(def candidate-root "C0")
(def policy-root "P1")
(def acceptance-root "A1")
(def release-root "L1")

(def author-evidence
  (record/ledger-evidence
   {:ledger/signer authority-root
    :ledger/transaction-root "transaction/root"
    :ledger/timestamp 1
    :ledger/previous-head-root nil
    :ledger/contract-root nil
    :ledger/template-root nil
    :ledger/global-state-root nil}))

(def c0
  (workspace/commit-candidate
   {:workspace/id workspace-id
    :workspace/root nil
    :commit/parent-roots []
    :commit/state-root "W0"
    :commit/operation-root nil
    :commit/merge-base-root nil
    :commit/merge-policy-root nil
    :commit/author-evidence author-evidence
    :commit/execution-provenance nil
    :commit/metadata {}
    :record/extensions {:test/root candidate-root}}))

(def c1
  (workspace/commit-candidate
   {:workspace/id workspace-id
    :workspace/root nil
    :commit/parent-roots [candidate-root]
    :commit/state-root "W1"
    :commit/operation-root "operation/C1"
    :commit/merge-base-root nil
    :commit/merge-policy-root nil
    :commit/author-evidence author-evidence
    :commit/execution-provenance nil
    :commit/metadata {}
    :record/extensions {:test/root "C1"}}))

(defn commit-root-valid?
  [root value]
  (= root (get-in value [:record/extensions :test/root])))

(def commit-store-c0
  (get
   (workspace/register-commit
    commit-root-valid? (workspace/commit-store) candidate-root c0)
   :ok))
(def commit-store
  (get
   (workspace/register-commit
    commit-root-valid? commit-store-c0 "C1" c1)
   :ok))

(def accepted
  (acceptance/main-acceptance-value
   workspace-id authority-root nil candidate-root
   policy-root ["R1"] 10))

(defn acceptance-root-valid?
  [root value]
  (and (= root acceptance-root) (= value accepted)))

(def acceptance-registration
  (release/register-acceptance
   acceptance-root-valid? (release/acceptance-store)
   acceptance-root workspace-id authority-root accepted))
(def acceptance-store (get acceptance-registration :ok))

(def published-release
  (release/release-value
   workspace-id authority-root "1.0.0"
   candidate-root policy-root acceptance-root 11))

(defn release-root-valid?
  [root value]
  (and (= root release-root) (= value published-release)))

(def release-registration
  (release/register-release
   release-root-valid? (release/release-store)
   release-root workspace-id authority-root published-release))
(def release-store (get release-registration :ok))

(def backend-0 (storage/memory-backend "release-lifecycle"))
(def policy-selection
  (storage/memory-compare-and-set-ref
   backend-0
   (storage/ref-update-request
    (workspace/workspace-scope workspace-id)
    acceptance/main-policy-ref-name
    nil policy-root authority-root)))
(def backend-policy (get policy-selection :ok))
(def main-selection
  (storage/memory-compare-and-set-ref
   backend-policy
   (storage/ref-update-request
    (workspace/workspace-scope workspace-id)
    workspace/main-ref-name
    nil candidate-root policy-root)))
(def backend-main (get main-selection :ok))

(def first-release
  (release/select-memory-release
   commit-store acceptance-store release-store backend-main
   workspace-id authority-root release-root))
(def backend-release (get first-release :ok))
(def duplicate-release
  (release/select-memory-release
   commit-store acceptance-store release-store backend-release
   workspace-id authority-root release-root))

(def wrong-version
  (assoc published-release :record/extensions
         {:workspace/id workspace-id
          :release/version "2.0.0"
          :release/acceptance-root acceptance-root
          :ref/expected-root nil
          :ref/desired-root candidate-root
          :ref/policy :release-publication-v1}))
(def wrong-policy
  (assoc published-release :attestation/context-root "P2"))
(def wrong-acceptance
  (assoc
   (assoc published-release
          :attestation/evidence-roots ["UNKNOWN"])
   :record/extensions
   {:workspace/id workspace-id
    :release/version "1.0.0"
    :release/acceptance-root "UNKNOWN"
    :ref/expected-root nil
    :ref/desired-root candidate-root
    :ref/policy :release-publication-v1}))

(def backend-wrong-main
  (get
   (storage/memory-compare-and-set-ref
    backend-policy
    (storage/ref-update-request
     (workspace/workspace-scope workspace-id)
     workspace/main-ref-name nil "C1" policy-root))
   :ok))

(def release-read
  (storage/memory-get-ref
   backend-release
   (storage/ref-read-request
    (workspace/workspace-scope workspace-id)
    (release/release-ref-name "1.0.0")
    policy-root)))

(def results
  [(test-check "release identity pins workspace and version"
               (get published-release :attestation/id)
               "release/world/orbital-station/1.0.0")
   (test-check "release subject is the immutable version ref and main root"
               [(get published-release :attestation/subject-id)
                (get published-release :attestation/subject-root)]
               ["release/1.0.0" candidate-root])
   (test-check "release pins policy and exact acceptance evidence"
               [(get published-release :attestation/context-root)
                (get published-release :attestation/evidence-roots)]
               [policy-root [acceptance-root]])
   (test-check "release claim pins its create-only CAS edge"
               [(get-in published-release
                        [:record/extensions :ref/expected-root])
                (get-in published-release
                        [:record/extensions :ref/desired-root])
                (get-in published-release
                        [:record/extensions :ref/policy])]
               [nil candidate-root :release-publication-v1])
   (test-check "acceptance and release root verification succeeds"
               [(get acceptance-registration :error)
                (get release-registration :error)]
               [nil nil])
   (test-check "current accepted main may be released"
               [(get first-release :error)
                (get-in first-release [:ref/value :ref/root])]
               [nil candidate-root])
   (test-check "release versions are create-only"
               [(get duplicate-release :error)
                (get duplicate-release :ref/actual-root)]
               [:storage/ref-conflict candidate-root])
   (test-check "selected release ref retains the accepted candidate"
               (get-in release-read [:ok :ref/root])
               candidate-root)
   (test-check "release version cannot be changed after construction"
               (release/release-shape-error
                workspace-id authority-root wrong-version)
               :workspace/release-id-not-derived)
   (test-check "an unselected policy cannot authorize release"
               (get
                (release/validate-release
                 commit-store acceptance-store backend-main
                 workspace-id authority-root wrong-policy)
                :error)
               :workspace/release-policy-not-published)
   (test-check "unknown acceptance evidence cannot authorize release"
               (get
                (release/validate-release
                 commit-store acceptance-store backend-main
                 workspace-id authority-root wrong-acceptance)
                :error)
               :workspace/release-acceptance-not-found)
   (test-check "only the currently accepted main root may be released"
               (get
                (release/validate-release
                 commit-store acceptance-store backend-wrong-main
                 workspace-id authority-root published-release)
                :error)
               :workspace/release-candidate-not-current-main)])

results
