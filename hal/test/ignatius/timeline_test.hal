(ns ignatius.timeline-test
  (:require [std.lib.test :as test]
            [ignatius.record :as record]
            [ignatius.timeline :as timeline]))

(def parent-run-reference
  (record/logical-reference
   {:reference/scope-id "world/orbital-station"
    :reference/kind :process/run
    :reference/id "run/layout-0"
    :reference/root nil
    :reference/metadata {}}))

(def initial
  (timeline/init
   {:workspace/id "world/orbital-station"
    :workspace/kind :scene
    :workspace/schema-root "scene-schema-root"
    :workspace/participants
    {"alice" true
     "bob" true}}))

(def rejected-outsider
  (timeline/apply-event
   initial
   {:action :process/start
    :process/id "run-1"
    :process/definition-root "definition-root"
    :signer "mallory"
    :transaction "tx-outsider"
    :timestamp 1
    :previous-head "head-0"}))

(def started
  (get
   (timeline/apply-event
    initial
    {:action :process/start
     :process/id "run-1"
     :process/definition-root "definition-root"
     :process/input-roots ["prompt-root" "scene-A"]
     :process/parent-references [parent-run-reference]
     :process/metadata {:agent :lighting}
     :signer "alice"
     :transaction "tx-start"
     :timestamp 2
     :previous-head "head-0"
     :contract "contract-root"
     :template "timeline-template-root"})
   :ok))

(def published-a
  (get
   (timeline/apply-event
    started
    {:action :artifact/publish
     :artifact/id "scene/main"
     :artifact/kind :scene
     :artifact/root "scene-A"
     :artifact/previous-root nil
     :artifact/source-roots []
     :artifact/schema-root "scene-schema-root"
     :artifact/metadata {:label "First scene"}
     :process/id "run-1"
     :signer "alice"
     :transaction "tx-publish-a"
     :timestamp 3
     :previous-head "head-1"})
   :ok))

(def rejected-stale-publish
  (timeline/apply-event
   published-a
   {:action :artifact/publish
    :artifact/id "scene/main"
    :artifact/kind :scene
    :artifact/content-root "scene-B"
    :artifact/previous-content-root "scene-before-A"
    :artifact/source-roots ["texture-root"]
    :process/id "run-1"
    :signer "bob"
    :transaction "tx-stale"
    :timestamp 4
    :previous-head "head-2"}))

(def published-b
  (get
   (timeline/apply-event
    published-a
    {:action :artifact/publish
     :artifact/id "scene/main"
     :artifact/kind :scene
     :artifact/content-root "scene-B"
     :artifact/previous-content-root "scene-A"
     :artifact/source-roots ["texture-root"]
     :artifact/schema-root "scene-schema-root"
     :artifact/metadata {:label "Lighting pass"}
     :process/id "run-1"
     :signer "bob"
     :transaction "tx-publish-b"
     :timestamp 5
     :previous-head "head-2"})
   :ok))

(def rejected-version-reuse
  (timeline/apply-event
   published-b
   {:action :artifact/publish
    :artifact/id "scene/main"
    :artifact/kind :scene
    :artifact/content-root "scene-A"
    :artifact/previous-content-root "scene-B"
    :artifact/source-roots []
    :process/id "run-1"
    :signer "alice"
    :transaction "tx-reuse"
    :timestamp 6
    :previous-head "head-3"}))

(def rejected-stale-review
  (timeline/apply-event
   published-b
   {:action :review/record
    :review/id "review-1"
    :review/decision :approve
    :review/evidence-roots ["notes-root"]
    :artifact/id "scene/main"
    :artifact/content-root "scene-A"
    :signer "alice"
    :transaction "tx-review-stale"
    :timestamp 7
    :previous-head "head-3"}))

(def reviewed
  (get
   (timeline/apply-event
    published-b
    {:action :review/record
     :review/id "review-1"
     :review/decision :approve
     :review/evidence-roots ["notes-root"]
     :review/metadata {:role :art-director}
     :artifact/id "scene/main"
     :artifact/content-root "scene-B"
     :process/id "run-1"
     :signer "alice"
     :transaction "tx-review"
     :timestamp 8
     :previous-head "head-3"})
   :ok))

(def completed
  (get
   (timeline/apply-event
    reviewed
    {:action :process/complete
     :process/id "run-1"
     :process/output-roots ["scene-B"]
     :process/result-root "result-root"
     :process/receipt-root "receipt-root"
     :signer "alice"
     :transaction "tx-complete"
     :timestamp 9
     :previous-head "head-4"})
   :ok))

(def latest
  (timeline/latest-entry completed))

(def results
  [(test/check "the contract state is a canonical workspace build"
               (get initial :record/type)
               :workspace/build)
   (test/check "the workspace records its stable logical identity"
               (get (timeline/summary initial) :workspace/id)
               "world/orbital-station")
   (test/check "the workspace state satisfies the canonical schema"
               (record/record-valid? initial)
               true)
   (test/check "only verified participants may advance the timeline"
               (get rejected-outsider :error)
               :timeline/not-participant)
   (test/check "process runs use the canonical record family"
               (get-in (timeline/processes started)
                       ["run-1" :record/type])
               :process/run)
   (test/check "process definitions and ledger evidence are pinned"
               (get-in (timeline/processes started)
                       ["run-1" :run/started-evidence
                        :ledger/transaction-root])
               "tx-start")
   (test/check "contract and template roots come from verified events"
               [(get-in (timeline/processes started)
                        ["run-1" :run/started-evidence
                         :ledger/contract-root])
                (get-in (timeline/processes started)
                        ["run-1" :run/started-evidence
                         :ledger/template-root])]
               ["contract-root" "timeline-template-root"])
   (test/check "process ancestry uses stable logical references"
               (get-in (timeline/processes started)
                       ["run-1" :run/parent-references])
               [parent-run-reference])
   (test/check "the compatibility artifact root alias remains accepted"
               (get-in (timeline/artifacts published-a)
                       ["scene/main" :artifact/content-root])
               "scene-A")
   (test/check "a first artifact version has no synthetic parent"
               (get-in (timeline/artifact-versions published-a)
                       ["scene/main" "scene-A"
                        :artifact/previous-content-root])
               nil)
   (test/check "artifact advancement requires the exact previous root"
               (get rejected-stale-publish :error)
               :timeline/stale-artifact-root)
   (test/check "artifact lineage is derived from accepted state"
               (get-in (timeline/artifact-versions published-b)
                       ["scene/main" "scene-B"
                        :artifact/previous-content-root])
               "scene-A")
   (test/check "artifact source roots remain explicit derivation provenance"
               (get-in (timeline/artifact-versions published-b)
                       ["scene/main" "scene-B"
                        :artifact/source-roots])
               ["texture-root"])
   (test/check "previous artifact versions remain directly queryable"
               (get-in (timeline/artifact-versions published-b)
                       ["scene/main" "scene-A"
                        :artifact/content-root])
               "scene-A")
   (test/check "artifact versions retain the stable producing run ID"
               (get-in (timeline/artifact-versions published-b)
                       ["scene/main" "scene-B"
                        :artifact/producer-run-id])
               "run-1")
   (test/check "an artifact root cannot overwrite an earlier version record"
               (get rejected-version-reuse :error)
               :timeline/artifact-version-already-exists)
   (test/check "reviews are pinned to the current exact artifact root"
               (get rejected-stale-review :error)
               :timeline/stale-review-subject)
   (test/check "reviews use the canonical decision record"
               (get-in (timeline/reviews reviewed)
                       ["review-1" :record/type])
               :review/decision)
   (test/check "review evidence comes from the verified event"
               (get-in (timeline/reviews reviewed)
                       ["review-1" :review/recorded-evidence
                        :ledger/signer])
               "alice")
   (test/check "accepted transitions form a canonical linked timeline"
               (get-in (timeline/entries completed)
                       ["tx-complete" :timeline/previous-entry-id])
               "tx-review")
   (test/check "the latest value is a timeline entry wrapper"
               (get latest :record/type)
               :timeline/entry)
   (test/check "the latest event is the completed canonical process run"
               [(get-in latest [:timeline/event :record/type])
                (get-in latest [:timeline/event :run/status])]
               [:process/run :complete])
   (test/check "completed processes retain their execution receipt"
               (get-in (timeline/processes completed)
                       ["run-1" :run/receipt-root])
               "receipt-root")
   (test/check "completed processes cannot be completed twice"
               (get
                (timeline/apply-event
                 completed
                 {:action :process/complete
                  :process/id "run-1"
                  :signer "alice"
                  :transaction "tx-complete-again"
                  :timestamp 10
                  :previous-head "head-5"})
                :error)
               :timeline/process-not-running)])

(test/print-results results)
