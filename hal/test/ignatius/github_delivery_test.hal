(ns ignatius.github-delivery-test
  (:require [std.lib.test :as test]
            [std.work.provider.memory :as memory]
            [ignatius.github.delivery :as delivery]
            [ignatius.github-workflow :as workflow]
            [ignatius.github-compatibility-vectors :as vectors]))

(def provider
  (memory/memory-store))

(def facts
  (get vectors/issue-open-v1 :facts))

(def events
  (workflow/event-plan facts))

(def plan-root
  "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")

(def first-transition
  (delivery/enqueue-plan!
   provider
   "delivery-opened"
   plan-root
   events))

(def replay-transition
  (delivery/enqueue-plan!
   provider
   "delivery-opened"
   plan-root
   events))

(def pending-before-claim
  (delivery/pending-submissions provider "delivery-opened"))

(def claimed
  (delivery/claim-submissions!
   provider
   "delivery-opened"
   "claim-signer-1"
   10))

(def acknowledged
  (delivery/acknowledge-submission!
   provider
   (get (first claimed) :outbox/id)
   "claim-signer-1"
   {:transaction/root
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}))

(def all-after-ack
  (delivery/list-submissions provider "delivery-opened"))

(defn conflicting-replay-rejected?
  []
  (try
    (do
      (delivery/enqueue-plan!
       provider
       "delivery-opened"
       plan-root
       [{:action :work/complete
         :workspace/id "greenways/ignatius"
         :work/id "different"}])
      false)
    (catch Throwable error
      true)))

(def results
  [(test/check "delivery transition queues one outbox row per planned event"
               (count (get first-transition :transition/outbox))
               2)
   (test/check "delivery and ordered outbox commit at one revision"
               (get first-transition :transition/revision)
               1)
   (test/check "same delivery and plan replay without new rows"
               (get replay-transition :transition/replayed)
               true)
   (test/check "replay retains exactly the original outbox"
               (count (get replay-transition :transition/outbox))
               2)
   (test/check "pending submission query is provider-neutral"
               (count pending-before-claim)
               2)
   (test/check "claim fences all selected submission intents"
               (get (first claimed) :outbox/claim-id)
               "claim-signer-1")
   (test/check "accepted submission stores its canonical receipt"
               (get-in acknowledged
                       [:outbox/ack :submission/receipt :transaction/root])
               "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
   (test/check "acknowledged submission remains in the durable outbox"
               (get (first all-after-ack) :outbox/status)
               :acked)
   (test/check "same delivery identity cannot carry a different plan"
               (conflicting-replay-rejected?)
               true)])

(test/print-results results)
