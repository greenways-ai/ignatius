(ns ignatius.workspace-proposal-test
  (:require [std.lib.test :as test]
            [ignatius.record :as record]
            [ignatius.workspace :as workspace]
            [ignatius.workspace-proposal :as proposal]))

(def workspace-id "world/orbital-station")
(def alice-root "account/alice")
(def bob-root "account/bob")

(def author-evidence
  (record/ledger-evidence
   {:ledger/signer alice-root
    :ledger/transaction-root "transaction/root"
    :ledger/timestamp 1700000000
    :ledger/previous-head-root "head/root"
    :ledger/contract-root nil
    :ledger/template-root nil
    :ledger/global-state-root nil}))

(defn root-valid?
  [root commit]
  (= root (get-in commit [:record/extensions :test/root])))

(defn candidate
  [root candidate-workspace parents state-root]
  (workspace/commit-candidate
   {:workspace/id candidate-workspace
    :workspace/root nil
    :commit/parent-roots parents
    :commit/state-root state-root
    :commit/operation-root
    (if (= 0 (count parents))
      nil
      (str "operation/" root))
    :commit/merge-base-root nil
    :commit/merge-policy-root nil
    :commit/author-evidence author-evidence
    :commit/execution-provenance nil
    :commit/metadata {}
    :record/extensions {:test/root root}}))

(def c0 (candidate "C0" workspace-id [] "W0"))
(def c1 (candidate "C1" workspace-id ["C0"] "W1"))
(def c2 (candidate "C2" workspace-id ["C0"] "W2"))
(def x0 (candidate "X0" "world/other" [] "WX"))

(def store-0 (workspace/commit-store))
(def store-c0
  (get
   (workspace/register-commit root-valid? store-0 "C0" c0)
   :ok))
(def store-c1
  (get
   (workspace/register-commit root-valid? store-c0 "C1" c1)
   :ok))
(def store-c2
  (get
   (workspace/register-commit root-valid? store-c1 "C2" c2)
   :ok))
(def store-all
  (get
   (workspace/register-commit root-valid? store-c2 "X0" x0)
   :ok))

(def alice-c1
  (proposal/proposal-publication-intent
   workspace-id alice-root "C1"))

(def bob-c1
  (proposal/proposal-publication-intent
   workspace-id bob-root "C1"))

(def alice-c2
  (proposal/proposal-publication-intent
   workspace-id alice-root "C2"))

(def unknown
  (proposal/proposal-publication-intent
   workspace-id alice-root "UNKNOWN"))

(def wrong-workspace
  (proposal/proposal-publication-intent
   workspace-id alice-root "X0"))

(def tampered-expected
  (assoc alice-c1 :ref/expected-root "C0"))

(def tampered-scope
  (assoc alice-c1 :ref/scope "workspace/other"))

(def tampered-name
  (assoc alice-c1 :ref/name "main"))

(def tampered-authorization
  (assoc alice-c1 :ref/authorization-root bob-root))

(def tampered-policy
  (assoc alice-c1 :ref/policy :personal-fast-forward-v1))

(def tampered-metadata
  (assoc alice-c1 :ref/metadata {:review "urgent"}))

(def tampered-extensions
  (assoc alice-c1 :record/extensions {:example/note "extra"}))

(def valid-c1
  (proposal/validate-proposal-publication
   store-all alice-root alice-c1))

(def valid-c2
  (proposal/validate-proposal-publication
   store-all alice-root alice-c2))

(def results
  [(test/check "proposal scope is derived from the workspace"
               (get alice-c1 :ref/scope)
               "workspace/world/orbital-station")
   (test/check "proposal name is the exact candidate root"
               (get alice-c1 :ref/name)
               "proposal/C1")
   (test/check "proposal publication is create-only"
               (get alice-c1 :ref/expected-root)
               nil)
   (test/check "proposal authorization is the verified origin"
               (get alice-c1 :ref/authorization-root)
               alice-root)
   (test/check "proposal publication pins an explicit policy"
               (get alice-c1 :ref/policy)
               :proposal-publication-v1)
   (test/check "proposal identity is independent of the publisher"
               [(get alice-c1 :ref/name)
                (get bob-c1 :ref/name)]
               ["proposal/C1" "proposal/C1"])
   (test/check "the signed intent still records its publisher"
               [(get alice-c1 :ref/authorization-root)
                (get bob-c1 :ref/authorization-root)]
               [alice-root bob-root])
   (test/check "one verified candidate is publishable"
               [(get valid-c1 :error)
                (get valid-c1 :ref/desired-root)]
               [nil "C1"])
   (test/check "sibling candidates are independent proposals"
               (get valid-c2 :error)
               nil)
   (test/check "proposal publication cannot replace a ref"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root tampered-expected)
                :error)
               :workspace/proposal-expected-root-not-nil)
   (test/check "clients cannot inject another scope"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root tampered-scope)
                :error)
               :workspace/ref-scope-not-derived)
   (test/check "proposal publication cannot target main"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root tampered-name)
                :error)
               :workspace/ref-name-not-proposal)
   (test/check "authorization cannot differ from the origin"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root tampered-authorization)
                :error)
               :workspace/ref-authorization-not-origin)
   (test/check "personal policy cannot be substituted"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root tampered-policy)
                :error)
               :workspace/unsupported-ref-policy)
   (test/check "proposal metadata is fixed in v1"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root tampered-metadata)
                :error)
               :workspace/ref-metadata-not-supported)
   (test/check "proposal extensions are fixed in v1"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root tampered-extensions)
                :error)
               :workspace/ref-extensions-not-supported)
   (test/check "unknown candidates cannot be published"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root unknown)
                :error)
               :workspace/desired-commit-not-found)
   (test/check "candidates must belong to the named workspace"
               (get
                (proposal/validate-proposal-publication
                 store-all alice-root wrong-workspace)
                :error)
               :workspace/desired-commit-workspace-mismatch)])

(test/print-results results)
