(ns ignatius.github-workflow
  (:require [ignatius.github :as github]))

(def workflow-format-version 1)

(defn event-plan
  "Pure workflow planner. Host adapters supply verified provider facts; Hara
   supplies validation, canonical identities and Ignatius event meaning."
  [event]
  (let [kind (get event :provider/event-kind)]
    (cond
      (= :github/issues kind)
      (github/plan-issue event)

      (= :github/push kind)
      (github/plan-push event)

      (= :github/check-run kind)
      (github/plan-check-complete event)

      :else
      {:error :github/unsupported-event})))
