(ns ignatius.github
  (:require [ignatius.github.issue :as issue]))

(def github-format-version 1)

(defn plan-issue
  [facts]
  (issue/plan facts))

(defn plan-issue-open
  [facts]
  (issue/plan
   (assoc facts :provider/event-action :opened)))

(defn plan-push
  "Compatibility entry point until the exact push mapper lands in the next
   migration slice. The host already supplies exact commit facts."
  [facts]
  (let [snapshot (get facts :snapshot)]
    [{:action :resource/register
      :workspace/id (get facts :workspace/id)
      :resource/id
      (str "github/"
           (get snapshot :repository/full-name)
           "/refs/heads/"
           (get snapshot :branch))
      :resource/kind :git/commit
      :resource/provider :github
      :resource/version (get snapshot :after)
      :resource/metadata
      {:provider/event-id (get facts :provider/delivery-id)
       :provider/event-kind :github/push}}]))

(defn plan-check-complete
  "Compatibility entry point until check-run snapshot validation is ported.
   Exact snapshot identity is supplied by the host capability."
  [facts]
  (let [version (get facts :snapshot/version)]
    [{:action :resource/register
      :workspace/id (get facts :workspace/id)
      :resource/kind :github/check-run-snapshot
      :resource/version version
      :resource/metadata
      {:provider :github}}
     {:action :work/checkpoint
      :workspace/id (get facts :workspace/id)
      :work/id (get facts :work/id)
      :checkpoint/state-root version}]))
