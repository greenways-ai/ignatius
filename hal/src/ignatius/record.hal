     :attestation/valid-from :attestation/valid-until
     :attestation/revokes-root :attestation/metadata]
    :schema/unknown-fields :preserve
    :schema/extensions :namespaced-map}

   :execution/provenance
   {:schema/record-type :execution/provenance
    :schema/version 1
    :schema/required
    [:provenance/code-root :provenance/compiler-root
     :provenance/runtime-root]
    :schema/known-fields
    [:provenance/source-root :provenance/expanded-root
     :provenance/code-root :provenance/namespace-root
     :provenance/compiler-root :provenance/runtime-root
     :provenance/artifact-root :provenance/target
     :provenance/optimization :provenance/input-roots
     :provenance/output-roots :provenance/receipt-root
     :provenance/effects-root :provenance/cost
     :provenance/metadata]
    :schema/unknown-fields :preserve
    :schema/extensions :namespaced-map}

   :ledger/evidence
   {:schema/record-type :ledger/evidence
    :schema/version 1
    :schema/required [:ledger/signer :ledger/timestamp]
    :schema/known-fields
    [:ledger/signer :ledger/transaction-root :ledger/timestamp
     :ledger/previous-head-root :ledger/contract-root
     :ledger/template-root :ledger/global-state-root]
    :schema/unknown-fields :preserve
    :schema/extensions :namespaced-map}})

(defn schema
  [record-type]
  (get schema-catalog record-type))

(defn field-kind
  [field]
  (get field-kinds field))

(defn missing-required-fields
  [value]
  (let [descriptor (schema (get value :record/type))]
    (if (= nil descriptor)
      []
      (reduce
       (fn [missing field]
         (if (= nil (get value field))
           (conj missing field)
           missing))
       []
       (get descriptor :schema/required)))))

(defn record-valid?
  [value]
  (let [descriptor (schema (get value :record/type))]
    (if (= nil descriptor)
      false
      (if (= record-format-version
             (get value :record/version))
        (= 0 (count (missing-required-fields value)))
        false))))

(defn validate-record
  [value]
  (let [descriptor (schema (get value :record/type))
        version (get value :record/version)]
    (cond
      (= nil descriptor)
      {:error :record/unsupported-type
       :record/type (get value :record/type)}

      (= false (= record-format-version version))
      {:error :record/unsupported-version
       :record/type (get value :record/type)
       :record/version version}

      :else
      (let [missing (missing-required-fields value)]
        (if (= 0 (count missing))
          {:ok value}
          {:error :record/missing-required-fields
           :record/type (get value :record/type)
           :fields missing})))))
