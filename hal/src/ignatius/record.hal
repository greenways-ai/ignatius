   :ledger/signer :stable-id
   :ledger/transaction-root :record-root
   :ledger/timestamp :timestamp
   :ledger/previous-head-root :record-root
   :ledger/contract-root :record-root
   :ledger/template-root :record-root
   :ledger/global-state-root :value-root})

(def schema-catalog
  {:workspace/build
   {:schema/record-type :workspace/build
    :schema/version 1
    :schema/required [:workspace/id :workspace/kind]
    :schema/known-fields
    [:workspace/id :workspace/kind :workspace/name
     :workspace/schema-root :workspace/entrypoints
     :workspace/participants :workspace/status
     :workspace/processes :workspace/artifacts
     :workspace/artifact-versions :workspace/reviews
     :workspace/timeline-entries :workspace/latest-entry-id
     :workspace/metadata]
    :schema/unknown-fields :preserve
    :schema/extensions :namespaced-map}

   :process/definition
   {:schema/record-type :process/definition
    :schema/version 1
    :schema/required
    [:process/id :process/kind :process/operation-root]
    :schema/known-fields
    [:process/id :process/kind :process/operation-root
     :process/input-schema-root :process/output-schema-root
     :process/config-root :process/dependency-roots
     :process/required-capability-roots :process/metadata]
    :schema/unknown-fields :preserve
    :schema/extensions :namespaced-map}

   :process/run
   {:schema/record-type :process/run
    :schema/version 1
    :schema/required [:run/id :run/definition-root :run/status]
    :schema/known-fields
    [:run/id :run/workspace-id :run/workspace-root
     :run/definition-root :run/status :run/input-roots
     :run/parent-references :run/output-roots :run/result-root
     :run/receipt-root :run/started-evidence
     :run/completed-evidence :run/metadata]
    :schema/unknown-fields :preserve
    :schema/extensions :namespaced-map}

   :process/step
   {:schema/record-type :process/step
    :schema/version 1
    :schema/required
    [:step/id :step/run-id :step/definition-root :step/status]
    :schema/known-fields
    [:step/id :step/run-id :step/run-root :step/definition-root
     :step/status :step/input-roots :step/output-roots
     :step/result-root :step/receipt-root :step/started-evidence
