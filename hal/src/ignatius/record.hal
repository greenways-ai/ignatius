(defn logical-reference
  "Represents a stable logical edge. A nil :reference/root resolves through a
  selected index; a non-nil root pins one exact immutable version. Logical
  cycles therefore remain possible while the storage graph stays acyclic."
  [fields]
  (record-envelope
   :reference/logical
   {:reference/scope-id (get fields :reference/scope-id)
    :reference/kind (get fields :reference/kind)
    :reference/id (get fields :reference/id)
    :reference/root (get fields :reference/root)
    :reference/metadata
    (map-or-empty (get fields :reference/metadata))
    :record/extensions
    (map-or-empty (get fields :record/extensions))}))

