(ns ignatius.record)

(def record-format-version 1)
(def unknown-fields-policy :preserve)
(def extension-policy :namespaced-map)

(def reserved-event-fields
  [:signer :transaction :timestamp :previous-head :contract :template])

(defn value-or
  [value fallback]
  (if (= nil value)
    fallback
    value))

(defn map-or-empty
  [value]
  (value-or value {}))

(defn vector-or-empty
  [value]
  (value-or value []))

(defn record-envelope
  "Adds the canonical record envelope. Writers emit every known v1 field and
  place application data beneath :record/extensions. Generic readers preserve
  unknown fields because they validate and return the supplied value unchanged."
  [record-type fields]
  (assoc
   (assoc
    (assoc fields :record/type record-type)
    :record/version record-format-version)
   :record/extensions
   (map-or-empty (get fields :record/extensions))))

(defn workspace-build
  [fields]
  (record-envelope
   :workspace/build
   {:workspace/id (get fields :workspace/id)
    :workspace/kind (get fields :workspace/kind)
    :workspace/name (get fields :workspace/name)
    :workspace/schema-root (get fields :workspace/schema-root)
    :workspace/entrypoints
    (map-or-empty (get fields :workspace/entrypoints))
    :workspace/participants
    (map-or-empty (get fields :workspace/participants))
    :workspace/status
    (value-or (get fields :workspace/status) :active)
    :workspace/processes
    (map-or-empty (get fields :workspace/processes))
    :workspace/artifacts
    (map-or-empty (get fields :workspace/artifacts))
    :workspace/artifact-versions
    (map-or-empty (get fields :workspace/artifact-versions))
    :workspace/reviews
    (map-or-empty (get fields :workspace/reviews))
    :workspace/timeline-entries
    (map-or-empty (get fields :workspace/timeline-entries))
    :workspace/latest-entry-id
    (get fields :workspace/latest-entry-id)
    :workspace/metadata
    (map-or-empty (get fields :workspace/metadata))
    :record/extensions
    (map-or-empty (get fields :record/extensions))}))

