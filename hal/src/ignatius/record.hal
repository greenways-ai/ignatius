    (map-or-empty (get fields :record/extensions))}))

(defn ledger-evidence-from-event
  "Copies only fields overwritten or supplied by the verified contract runtime."
  [event]
  (ledger-evidence
   {:ledger/signer (get event :signer)
    :ledger/transaction-root (get event :transaction)
    :ledger/timestamp (get event :timestamp)
    :ledger/previous-head-root (get event :previous-head)
    :ledger/contract-root (get event :contract)
    :ledger/template-root (get event :template)
    :ledger/global-state-root nil}))

(def field-kinds
  {:record/type :record-type
   :record/version :integer
   :record/extensions :extension-map

   :workspace/id :stable-id
   :workspace/root :record-root
   :workspace/kind :keyword
   :workspace/name :value
   :workspace/schema-root :schema-root
   :workspace/entrypoints :root-map
   :workspace/participants :map
   :workspace/status :keyword
   :workspace/processes :record-map
   :workspace/artifacts :record-map
   :workspace/artifact-versions :record-map
   :workspace/reviews :record-map
   :workspace/timeline-entries :record-map
   :workspace/latest-entry-id :stable-id
   :workspace/metadata :map

   :process/id :stable-id
   :process/kind :keyword
   :process/operation-root :code-root
   :process/input-schema-root :schema-root
   :process/output-schema-root :schema-root
   :process/config-root :value-root
   :process/dependency-roots :root-vector
   :process/required-capability-roots :record-root-vector
   :process/metadata :map

   :run/id :stable-id
   :run/workspace-id :stable-id
   :run/workspace-root :record-root
   :run/definition-root :record-root
   :run/status :keyword
   :run/input-roots :root-vector
   :run/parent-references :logical-reference-vector
   :run/output-roots :root-vector
   :run/result-root :value-root
   :run/receipt-root :receipt-root
   :run/started-evidence :record-value
   :run/completed-evidence :record-value
   :run/metadata :map

   :step/id :stable-id
   :step/run-id :stable-id
   :step/run-root :record-root
   :step/definition-root :record-root
   :step/status :keyword
   :step/input-roots :root-vector
   :step/output-roots :root-vector
   :step/result-root :value-root
   :step/receipt-root :receipt-root
   :step/started-evidence :record-value
   :step/completed-evidence :record-value
   :step/metadata :map

   :checkpoint/id :stable-id
   :checkpoint/run-id :stable-id
   :checkpoint/run-root :record-root
   :checkpoint/step-id :stable-id
   :checkpoint/step-root :record-root
   :checkpoint/state-root :value-root
   :checkpoint/output-roots :root-vector
   :checkpoint/receipt-root :receipt-root
   :checkpoint/evidence :record-value
   :checkpoint/metadata :map

   :artifact/id :stable-id
   :artifact/workspace-id :stable-id
   :artifact/workspace-root :record-root
   :artifact/kind :keyword
   :artifact/schema-root :schema-root
   :artifact/metadata :map
   :artifact/content-root :content-root
   :artifact/previous-content-root :content-root
   :artifact/source-roots :root-vector
   :artifact/producer-run-id :stable-id
   :artifact/producer-run-root :record-root
   :artifact/published-evidence :record-value

   :reference/scope-id :stable-id
   :reference/kind :keyword
   :reference/id :stable-id
   :reference/root :record-root
   :reference/metadata :map

   :timeline/id :stable-id
   :timeline/previous-entry-id :stable-id
   :timeline/event :record-value
   :timeline/evidence :record-value
   :timeline/subject-reference :logical-reference
   :timeline/sequence :integer
   :timeline/metadata :map

   :commit/parent-roots :record-root-vector
   :commit/state-root :value-root
   :commit/operation-root :code-root
   :commit/merge-base-root :record-root
   :commit/merge-policy-root :code-root
   :commit/author-evidence :record-value
   :commit/execution-provenance :record-value
   :commit/metadata :map

   :review/id :stable-id
   :review/subject-id :stable-id
   :review/subject-root :record-root
   :review/decision :keyword
   :review/evidence-roots :root-vector
   :review/process-run-id :stable-id
   :review/process-run-root :record-root
   :review/recorded-evidence :record-value
   :review/metadata :map

   :attestation/id :stable-id
   :attestation/claim :keyword
   :attestation/subject-id :stable-id
   :attestation/subject-root :record-root
   :attestation/context-root :record-root
   :attestation/evidence-roots :root-vector
   :attestation/process-run-id :stable-id
   :attestation/process-run-root :record-root
   :attestation/issuer-evidence :record-value
   :attestation/scope :value
   :attestation/audience :value
   :attestation/valid-from :timestamp
   :attestation/valid-until :timestamp
   :attestation/revokes-root :record-root
   :attestation/metadata :map

   :provenance/source-root :source-root
   :provenance/expanded-root :code-root
   :provenance/code-root :code-root
   :provenance/namespace-root :record-root
   :provenance/compiler-root :record-root
   :provenance/runtime-root :record-root
   :provenance/artifact-root :artifact-root
   :provenance/target :keyword
   :provenance/optimization :keyword
   :provenance/input-roots :root-vector
   :provenance/output-roots :root-vector
   :provenance/receipt-root :receipt-root
