(ns ignatius.timeline
  (:require [ignatius.record :as record]))

(def timeline-format-version 2)

(defn verified-evidence
  "Copies only ledger-injected evidence from a verified contract event."
  [event]
  (record/ledger-evidence-from-event event))

(defn parameter-or
  [parameters canonical compatibility]
  (let [value (get parameters canonical)]
    (if (= nil value)
      (get parameters compatibility)
      value)))

(defn event-or
  [event canonical compatibility]
  (let [value (get event canonical)]
    (if (= nil value)
      (get event compatibility)
      value)))

(defn participant?
  [state signer]
  (= true
     (get (get state :workspace/participants) signer)))

(defn active?
  [state]
  (= :active (get state :workspace/status)))

(defn entry-id
  [event]
  (if (= nil (get event :transaction))
    (get event :previous-head)
    (get event :transaction)))

(defn process-parent-references
  [event]
  (record/vector-or-empty
   (event-or event
             :process/parent-references
             :process/parent-runs)))

(defn process-reference
  [state process-id]
  (record/logical-reference
   {:reference/scope-id (get state :workspace/id)
    :reference/kind :process/run
    :reference/id process-id
    :reference/root nil
    :reference/metadata {}}))

(defn artifact-reference
  [state artifact-id artifact-root]
  (record/logical-reference
   {:reference/scope-id (get state :workspace/id)
    :reference/kind :artifact
    :reference/id artifact-id
    :reference/root artifact-root
    :reference/metadata {}}))

(defn append-entry
  "Adds one canonical transition entry to a reverse-linked timeline index."
  [state event subject-reference entry]
  (let [id (entry-id event)
        previous-id (get state :workspace/latest-entry-id)
        linked-entry
        (record/timeline-entry
         {:timeline/id id
          :timeline/previous-entry-id previous-id
          :timeline/event entry
          :timeline/evidence (verified-evidence event)
          :timeline/subject-reference subject-reference
          :timeline/sequence nil
          :timeline/metadata {}})
        entries (get state :workspace/timeline-entries)
        with-entry
        (assoc state :workspace/timeline-entries
               (assoc entries id linked-entry))]
    (assoc with-entry :workspace/latest-entry-id id)))

(defn init
  "Creates a linear signed build workspace using the canonical v1 records.

  Compatibility aliases remain accepted for :participants and the original
  timeline parameters. The returned state is a :workspace/build value."
  [parameters]
  (record/workspace-build
   {:workspace/id (get parameters :workspace/id)
    :workspace/kind (get parameters :workspace/kind)
    :workspace/name (get parameters :workspace/name)
    :workspace/schema-root (get parameters :workspace/schema-root)
    :workspace/entrypoints
    (get parameters :workspace/entrypoints)
    :workspace/participants
    (parameter-or parameters :workspace/participants :participants)
    :workspace/status :active
    :workspace/processes {}
    :workspace/artifacts {}
    :workspace/artifact-versions {}
    :workspace/reviews {}
    :workspace/timeline-entries {}
    :workspace/latest-entry-id nil
    :workspace/metadata (get parameters :workspace/metadata)
    :record/extensions (get parameters :record/extensions)}))

(defn start-process
  [state event]
  (let [process-id (get event :process/id)
        definition-root (get event :process/definition-root)
        processes (get state :workspace/processes)
        current (get processes process-id)
        evidence (verified-evidence event)]
    (cond
      (= nil process-id)
      {:error :timeline/missing-process-id}

      (= nil definition-root)
      {:error :timeline/missing-process-definition}

      (= nil current)
      (let [run
            (record/process-run
             {:run/id process-id
              :run/workspace-id (get state :workspace/id)
              :run/workspace-root nil
              :run/definition-root definition-root
              :run/status :running
              :run/input-roots (get event :process/input-roots)
              :run/parent-references
              (process-parent-references event)
              :run/output-roots []
              :run/result-root nil
              :run/receipt-root nil
              :run/started-evidence evidence
              :run/completed-evidence nil
              :run/metadata (get event :process/metadata)})
            with-run
            (assoc state :workspace/processes
                   (assoc processes process-id run))]
        {:ok
         (append-entry
          with-run event
          (process-reference state process-id)
          run)})

      :else
      {:error :timeline/process-already-exists})))

(defn complete-process
  [state event]
  (let [process-id (get event :process/id)
        processes (get state :workspace/processes)
        current (get processes process-id)]
    (cond
      (= nil current)
      {:error :timeline/process-not-found}

      (= :running (get current :run/status))
      (let [with-status
            (assoc current :run/status :complete)
            with-outputs
            (assoc with-status :run/output-roots
                   (record/vector-or-empty
                    (get event :process/output-roots)))
            with-result
            (assoc with-outputs :run/result-root
                   (get event :process/result-root))
            with-receipt
            (assoc with-result :run/receipt-root
                   (get event :process/receipt-root))
            completed
            (assoc with-receipt :run/completed-evidence
                   (verified-evidence event))
            with-process
            (assoc state :workspace/processes
                   (assoc processes process-id completed))]
        {:ok
         (append-entry
          with-process event
          (process-reference state process-id)
          completed)})

      :else
      {:error :timeline/process-not-running})))

(defn artifact-versions-for
  [state artifact-id]
  (let [versions
        (get (get state :workspace/artifact-versions) artifact-id)]
    (if (= nil versions)
      {}
      versions)))

(defn publish-artifact
  [state event]
  (let [artifact-id (get event :artifact/id)
        artifact-root
        (event-or event :artifact/content-root :artifact/root)
        expected-root
        (event-or event
                  :artifact/previous-content-root
                  :artifact/previous-root)
        process-id (get event :process/id)
        processes (get state :workspace/processes)
        process (get processes process-id)
        artifacts (get state :workspace/artifacts)
        current (get artifacts artifact-id)
        current-root
        (if (= nil current)
          nil
          (get current :artifact/content-root))
        versions (artifact-versions-for state artifact-id)
        existing-version (get versions artifact-root)]
    (cond
      (= nil artifact-id)
      {:error :timeline/missing-artifact-id}

      (= nil artifact-root)
      {:error :timeline/missing-artifact-root}

      (= nil process)
      {:error :timeline/process-not-found}

      (= false (= expected-root current-root))
      {:error :timeline/stale-artifact-root}

      (= false (= nil existing-version))
      {:error :timeline/artifact-version-already-exists}

      :else
      (let [version
            (record/artifact-version
             {:artifact/id artifact-id
              :artifact/kind (get event :artifact/kind)
              :artifact/content-root artifact-root
              :artifact/previous-content-root current-root
              :artifact/source-roots
              (get event :artifact/source-roots)
              :artifact/producer-run-id process-id
              :artifact/producer-run-root nil
              :artifact/schema-root (get event :artifact/schema-root)
              :artifact/metadata (get event :artifact/metadata)
              :artifact/published-evidence
              (verified-evidence event)})
            all-versions (get state :workspace/artifact-versions)
            with-current
            (assoc state :workspace/artifacts
                   (assoc artifacts artifact-id version))
            with-version
            (assoc
             with-current
             :workspace/artifact-versions
             (assoc
              all-versions
              artifact-id
              (assoc versions artifact-root version)))]
        {:ok
         (append-entry
          with-version event
          (artifact-reference state artifact-id artifact-root)
          version)}))))

(defn review-evidence-roots
  [event]
  (let [roots (get event :review/evidence-roots)]
    (if (= nil roots)
      (let [root (get event :review/evidence-root)]
        (if (= nil root)
          []
          [root]))
      roots)))

(defn record-review
  [state event]
  (let [review-id (get event :review/id)
        artifact-id (get event :artifact/id)
        artifact-root
        (event-or event :artifact/content-root :artifact/root)
        artifacts (get state :workspace/artifacts)
        artifact (get artifacts artifact-id)
        reviews (get state :workspace/reviews)
        current-review (get reviews review-id)]
    (cond
      (= nil review-id)
      {:error :timeline/missing-review-id}

      (= nil artifact)
      {:error :timeline/artifact-not-found}

      (= false
         (= artifact-root (get artifact :artifact/content-root)))
      {:error :timeline/stale-review-subject}

      (= false (= nil current-review))
      {:error :timeline/review-already-exists}

      :else
      (let [review
            (record/review-decision
             {:review/id review-id
              :review/subject-id artifact-id
              :review/subject-root artifact-root
              :review/decision (get event :review/decision)
              :review/evidence-roots
              (review-evidence-roots event)
              :review/process-run-id (get event :process/id)
              :review/process-run-root nil
              :review/recorded-evidence
              (verified-evidence event)
              :review/metadata (get event :review/metadata)})
            with-review
            (assoc state :workspace/reviews
                   (assoc reviews review-id review))]
        {:ok
         (append-entry
          with-review event
          (artifact-reference state artifact-id artifact-root)
          review)}))))

(defn apply-event
  [state event]
  (let [action (get event :action)]
    (cond
      (= false (active? state))
      {:error :timeline/not-active}

      (= false
         (participant? state (get event :signer)))
      {:error :timeline/not-participant}

      (= action :process/start)
      (start-process state event)

      (= action :process/complete)
      (complete-process state event)

      (= action :artifact/publish)
      (publish-artifact state event)

      (= action :review/record)
      (record-review state event)

      :else
      {:error :timeline/unknown-action})))

(defn summary
  [state]
  {:workspace/id (get state :workspace/id)
   :workspace/kind (get state :workspace/kind)
   :workspace/schema-root (get state :workspace/schema-root)
   :workspace/status (get state :workspace/status)
   :workspace/latest-entry-id (get state :workspace/latest-entry-id)
   :workspace/processes (get state :workspace/processes)
   :workspace/artifacts (get state :workspace/artifacts)
   :workspace/reviews (get state :workspace/reviews)})

(defn workspace
  [state]
  state)

(defn processes
  [state]
  (get state :workspace/processes))

(defn artifacts
  [state]
  (get state :workspace/artifacts))

(defn artifact-versions
  [state]
  (get state :workspace/artifact-versions))

(defn reviews
  [state]
  (get state :workspace/reviews))

(defn entries
  [state]
  (get state :workspace/timeline-entries))

(defn latest-entry
  [state]
  (get
   (get state :workspace/timeline-entries)
   (get state :workspace/latest-entry-id)))
