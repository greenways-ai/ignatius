(ns ignatius.timeline)

(def timeline-format-version 1)

(defn verified-provenance
  "Copies only ledger-injected provenance from a verified contract event."
  [event]
  {:record/type :timeline/provenance
   :timeline/signer (get event :signer)
   :timeline/transaction (get event :transaction)
   :timeline/timestamp (get event :timestamp)
   :timeline/previous-head (get event :previous-head)})

(defn participant?
  [state signer]
  (= true
     (get (get state :timeline/participants) signer)))

(defn active?
  [state]
  (= :active (get state :timeline/status)))

(defn entry-id
  [event]
  (if (= nil (get event :transaction))
    (get event :previous-head)
    (get event :transaction)))

(defn append-entry
  "Adds one immutable transition record to a reverse-linked timeline index."
  [state event entry]
  (let [id (entry-id event)
        previous-id (get state :timeline/latest-entry)
        linked-entry
        (assoc
         (assoc entry :timeline/entry-id id)
         :timeline/previous-entry-id previous-id)
        entries (get state :timeline/entries)
        with-entry
        (assoc state :timeline/entries
               (assoc entries id linked-entry))]
    (assoc with-entry :timeline/latest-entry id)))

(defn init
  "Creates a linear signed build timeline.

  The contract creator supplies the stable workspace identity, participant set
  and optional schema root. Ignatius supplies identity and ordering facts on
  every later event."
  [parameters]
  {:record/type :timeline/build
   :timeline/format-version timeline-format-version
   :timeline/workspace-id (get parameters :workspace/id)
   :timeline/workspace-kind (get parameters :workspace/kind)
   :timeline/schema-root (get parameters :workspace/schema-root)
   :timeline/participants (get parameters :participants)
   :timeline/status :active
   :timeline/processes {}
   :timeline/artifacts {}
   :timeline/artifact-versions {}
   :timeline/reviews {}
   :timeline/entries {}
   :timeline/latest-entry nil})

(defn start-process
  [state event]
  (let [process-id (get event :process/id)
        definition-root (get event :process/definition-root)
        processes (get state :timeline/processes)
        current (get processes process-id)
        provenance (verified-provenance event)]
    (cond
      (= nil process-id)
      {:error :timeline/missing-process-id}

      (= nil definition-root)
      {:error :timeline/missing-process-definition}

      (= nil current)
      (let [run
            {:record/type :timeline/process-run
             :process/id process-id
             :process/definition-root definition-root
             :process/input-roots (get event :process/input-roots)
             :process/parent-runs (get event :process/parent-runs)
             :process/status :running
             :process/started provenance}
            entry
            {:record/type :timeline/process-started
             :process/id process-id
             :process/definition-root definition-root
             :process/input-roots (get event :process/input-roots)
             :process/parent-runs (get event :process/parent-runs)
             :process/started provenance}
            with-run
            (assoc state :timeline/processes
                   (assoc processes process-id run))]
        {:ok (append-entry with-run event entry)})

      :else
      {:error :timeline/process-already-exists})))

(defn complete-process
  [state event]
  (let [process-id (get event :process/id)
        processes (get state :timeline/processes)
        current (get processes process-id)]
    (cond
      (= nil current)
      {:error :timeline/process-not-found}

      (= :running (get current :process/status))
      (let [provenance (verified-provenance event)
            output-roots (get event :process/output-roots)
            result-root (get event :process/result-root)
            receipt-root (get event :process/receipt-root)
            with-status
            (assoc current :process/status :complete)
            with-outputs
            (assoc with-status :process/output-roots output-roots)
            with-result
            (assoc with-outputs :process/result-root result-root)
            with-receipt
            (assoc with-result :process/receipt-root receipt-root)
            completed
            (assoc with-receipt :process/completed provenance)
            entry
            {:record/type :timeline/process-completed
             :process/id process-id
             :process/output-roots output-roots
             :process/result-root result-root
             :process/receipt-root receipt-root
             :process/completed provenance}
            with-process
            (assoc state :timeline/processes
                   (assoc processes process-id completed))]
        {:ok (append-entry with-process event entry)})

      :else
      {:error :timeline/process-not-running})))

(defn artifact-versions-for
  [state artifact-id]
  (let [versions
        (get (get state :timeline/artifact-versions) artifact-id)]
    (if (= nil versions)
      {}
      versions)))

(defn publish-artifact
  [state event]
  (let [artifact-id (get event :artifact/id)
        artifact-root (get event :artifact/root)
        expected-root (get event :artifact/previous-root)
        process-id (get event :process/id)
        processes (get state :timeline/processes)
        process (get processes process-id)
        artifacts (get state :timeline/artifacts)
        current (get artifacts artifact-id)
        current-root
        (if (= nil current)
          nil
          (get current :artifact/root))
        versions (artifact-versions-for state artifact-id)
        existing-version (get versions artifact-root)]
    (cond
      (= nil artifact-id)
      {:error :timeline/missing-artifact-id}

      (= nil artifact-root)
      {:error :timeline/missing-artifact-root}

      (= nil process)
      {:error :timeline/process-not-found}

      (= false (= expected-root current-root))
      {:error :timeline/stale-artifact-root}

      (= false (= nil existing-version))
      {:error :timeline/artifact-version-already-exists}

      :else
      (let [version
            {:record/type :timeline/artifact-version
             :artifact/id artifact-id
             :artifact/kind (get event :artifact/kind)
             :artifact/root artifact-root
             :artifact/previous-root current-root
             :artifact/source-roots (get event :artifact/source-roots)
             :artifact/process-id process-id
             :artifact/schema-root (get event :artifact/schema-root)
             :artifact/metadata (get event :artifact/metadata)
             :artifact/published (verified-provenance event)}
            all-versions (get state :timeline/artifact-versions)
            with-current
            (assoc state :timeline/artifacts
                   (assoc artifacts artifact-id version))
            with-version
            (assoc
             with-current
             :timeline/artifact-versions
             (assoc
              all-versions
              artifact-id
              (assoc versions artifact-root version)))]
        {:ok (append-entry with-version event version)}))))

(defn record-review
  [state event]
  (let [review-id (get event :review/id)
        artifact-id (get event :artifact/id)
        artifact-root (get event :artifact/root)
        artifacts (get state :timeline/artifacts)
        artifact (get artifacts artifact-id)
        reviews (get state :timeline/reviews)
        current-review (get reviews review-id)]
    (cond
      (= nil review-id)
      {:error :timeline/missing-review-id}

      (= nil artifact)
      {:error :timeline/artifact-not-found}

      (= false
         (= artifact-root (get artifact :artifact/root)))
      {:error :timeline/stale-review-subject}

      (= false (= nil current-review))
      {:error :timeline/review-already-exists}

      :else
      (let [review
            {:record/type :timeline/review
             :review/id review-id
             :review/artifact-id artifact-id
             :review/artifact-root artifact-root
             :review/decision (get event :review/decision)
             :review/evidence-root (get event :review/evidence-root)
             :review/recorded (verified-provenance event)}
            with-review
            (assoc state :timeline/reviews
                   (assoc reviews review-id review))]
        {:ok (append-entry with-review event review)}))))

(defn apply-event
  [state event]
  (let [action (get event :action)]
    (cond
      (= false (active? state))
      {:error :timeline/not-active}

      (= false
         (participant? state (get event :signer)))
      {:error :timeline/not-participant}

      (= action :process/start)
      (start-process state event)

      (= action :process/complete)
      (complete-process state event)

      (= action :artifact/publish)
      (publish-artifact state event)

      (= action :review/record)
      (record-review state event)

      :else
      {:error :timeline/unknown-action})))

(defn summary
  [state]
  {:workspace/id (get state :timeline/workspace-id)
   :workspace/kind (get state :timeline/workspace-kind)
   :workspace/schema-root (get state :timeline/schema-root)
   :timeline/status (get state :timeline/status)
   :timeline/latest-entry (get state :timeline/latest-entry)
   :timeline/processes (get state :timeline/processes)
   :timeline/artifacts (get state :timeline/artifacts)
   :timeline/reviews (get state :timeline/reviews)})

(defn processes
  [state]
  (get state :timeline/processes))

(defn artifacts
  [state]
  (get state :timeline/artifacts))

(defn artifact-versions
  [state]
  (get state :timeline/artifact-versions))

(defn reviews
  [state]
  (get state :timeline/reviews))

(defn entries
  [state]
  (get state :timeline/entries))

(defn latest-entry
  [state]
  (get
   (get state :timeline/entries)
   (get state :timeline/latest-entry)))
